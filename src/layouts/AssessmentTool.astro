---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

const base = import.meta.env.BASE_URL;

type Pillar = { key: string; name: string; questions: string[] };
type Band = { min: number; max: number; name: string; blurb: string; cta: string };
type Track = { pillars: Pillar[]; bands: Band[] };

export interface Props {
  slug: string;
  pageTitle: string;
  metaDescription: string;
  kicker: string;
  heroTitle: string;
  heroIntro: string;
  // Either provide a flat pillars/bands pair (single-track tools, e.g. the
  // procurement check), or a gate + tracks (branching tools, e.g. the RAP
  // assessment routing "no RAP yet" vs "already have a RAP" to different
  // question sets before any scoring question appears).
  pillars?: Pillar[];
  bands?: Band[];
  gate?: { question: string; options: { value: string; label: string }[] };
  tracks?: Record<string, Track>;
  emailSubject: string;
  disclaimer?: string;
  crossLink?: { label: string; href: string };
}

const {
  slug,
  pageTitle,
  metaDescription,
  kicker,
  heroTitle,
  heroIntro,
  pillars,
  bands,
  gate,
  tracks: tracksProp,
  emailSubject,
  disclaimer,
  crossLink
} = Astro.props;

// Normalise to always work with a track map internally. Non-branching tools
// (no `gate`) get a single implicit "default" track from the flat props, so
// the rendering/JS below has exactly one code path either way.
const tracks: Record<string, Track> = gate ? (tracksProp as Record<string, Track>) : { default: { pillars: pillars!, bands: bands! } };
const trackKeys = Object.keys(tracks);
const maxScoreByTrack = Object.fromEntries(
  trackKeys.map((k) => [k, tracks[k].pillars.reduce((n, p) => n + p.questions.length, 0) * 3])
);

const options = [
  { label: 'Not yet', value: 0 },
  { label: 'Just started', value: 1 },
  { label: 'In progress', value: 2 },
  { label: 'Well established', value: 3 }
];
---
<BaseLayout
  title={`${pageTitle} | ${SITE.name}`}
  description={metaDescription}
  canonical={`${SITE.url}/${slug}/`}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 hero-pattern"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 md:py-20 text-center">
      <p class="kicker">{kicker}</p>
      <h1 class="mt-3 text-3xl md:text-5xl font-extrabold text-white leading-tight">{heroTitle}</h1>
      <p class="mt-4 text-white/80">{heroIntro}</p>
    </div>
  </section>

  <section class="section max-w-3xl">
    <form id="assessment-form" class="space-y-10">

      {gate && (
        <fieldset id="gate-fieldset">
          <legend class="kicker mb-4">{gate.question}</legend>
          <div class="grid sm:grid-cols-2 gap-3">
            {gate.options.map((opt) => (
              <button type="button" class="gate-option grid-card text-left card-raise" data-track={opt.value}>
                <span class="font-semibold">{opt.label}</span>
              </button>
            ))}
          </div>
        </fieldset>
      )}

      <div id="progress-card" class="grid-card !bg-white text-slate-900" style={gate ? 'display:none' : undefined}>
        <div class="flex items-center justify-between text-sm font-semibold">
          <span id="progress-label">0 answered</span>
          <span id="progress-pct" class="tabular-nums">0%</span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-slate-200 overflow-hidden">
          <div id="progress-bar" class="h-full bg-brand-light" style="width:0%"></div>
        </div>
      </div>

      {trackKeys.map((trackKey) => (
        <div class="track-questions space-y-10" data-track={trackKey} style={gate ? 'display:none' : undefined}>
          {gate && (
            <button type="button" id={`change-track-${trackKey}`} class="change-track-btn text-sm underline text-brand-light">
              ← Change your starting point
            </button>
          )}
          {tracks[trackKey].pillars.map((pillar) => (
            <fieldset>
              <legend class="kicker mb-4">{pillar.name}</legend>
              <div class="space-y-6">
                {pillar.questions.map((q, qIdx) => {
                  const name = `${trackKey}__${pillar.key}-${qIdx}`;
                  return (
                    <div class="grid-card">
                      <p class="font-medium">{q}</p>
                      <div class="mt-3 grid sm:grid-cols-2 gap-2">
                        {options.map((opt) => (
                          <label class="flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2 text-sm cursor-pointer hover:bg-white/10">
                            <input type="radio" name={name} value={opt.value} class="assessment-input" data-track={trackKey} />
                            {opt.label}
                          </label>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            </fieldset>
          ))}
        </div>
      ))}

      <button type="submit" id="submit-btn" class="btn w-full sm:w-auto" style={gate ? 'display:none' : undefined}>See my result</button>
    </form>

    <div id="results" class="hidden">
      <div class="grid-card !bg-white text-slate-900">
        <p class="kicker text-center md:text-left">Your Result</p>

        <div class="mt-4 grid md:grid-cols-[200px_1fr] gap-8 items-center">
          <!-- Score gauge -->
          <div class="flex flex-col items-center">
            <div class="relative" style="width:160px;height:160px;">
              <canvas id="result-gauge" aria-hidden="true" style="display:block;width:100%;height:100%;"></canvas>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span id="result-pct" class="text-3xl font-extrabold tabular-nums" style="color:#0D1B2A;">0%</span>
                <span id="result-score" class="text-xs text-slate-500 mt-1 tabular-nums">0 points</span>
              </div>
            </div>
            <h2 id="result-band" class="mt-4 text-xl font-bold text-center" style="color:#0D1B2A;"></h2>
          </div>

          <!-- Blurb + radar -->
          <div>
            <p class="text-slate-700" id="result-blurb"></p>
            <div class="mt-4 mx-auto md:mx-0" id="result-radar-wrap" style="max-width:100%;">
              <canvas id="result-radar" aria-hidden="true" style="display:block;width:100%;height:auto;"></canvas>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t grid grid-cols-2 sm:grid-cols-4 gap-4 text-center" id="result-breakdown"></div>

        {disclaimer && <p class="mt-6 text-xs text-slate-500 border-t pt-4">{disclaimer}</p>}

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a id="result-cta" href={`${base}contact/`} class="btn">Talk to us about your result</a>
          <button type="button" id="retake-btn" class="btn-outline !text-slate-700 !border-slate-300">Retake assessment</button>
        </div>
        {crossLink && (
          <p class="mt-4 text-sm text-slate-600 text-center">
            Also worth checking: <a href={`${base}${crossLink.href}`} class="underline">{crossLink.label}</a>
          </p>
        )}
      </div>

      <div class="grid-card mt-6">
        <h3 class="font-semibold">Want a copy emailed to you?</h3>
        <p class="text-sm text-white/70 mt-1">Optional — leave your details and we'll send your result and some relevant next steps.</p>
        <form
          id="results-email-form"
          action="https://formspree.io/f/xgvwovew"
          method="POST"
          class="mt-4 grid sm:grid-cols-[1fr_1fr_auto] gap-3"
        >
          <input type="hidden" name="_subject" value={emailSubject} />
          <input type="hidden" name="assessment_score" id="email-score-field" value="" />
          <input type="hidden" name="assessment_band" id="email-band-field" value="" />
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
          <input name="name" required placeholder="Your name" class="w-full border rounded-xl px-3 py-2.5 text-slate-900" />
          <input type="email" name="email" required placeholder="Work email" class="w-full border rounded-xl px-3 py-2.5 text-slate-900" />
          <button type="submit" class="btn">Email my result</button>
        </form>
        <p id="email-sent-msg" class="hidden mt-3 text-sm text-brand-light">Thanks — we'll be in touch shortly.</p>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>

  <script
    type="application/json"
    id="assessment-data"
    set:html={JSON.stringify({
      slug,
      hasGate: Boolean(gate),
      tracks: Object.fromEntries(
        trackKeys.map((k) => [
          k,
          {
            pillars: tracks[k].pillars.map((p) => ({ key: p.key, name: p.name, count: p.questions.length })),
            bands: tracks[k].bands,
            maxScore: maxScoreByTrack[k]
          }
        ])
      ),
      base
    })}
  />

  <script is:inline>
    const data = JSON.parse(document.getElementById('assessment-data').textContent);
    const form = document.getElementById('assessment-form');
    const progressCard = document.getElementById('progress-card');
    const progressLabel = document.getElementById('progress-label');
    const progressPct = document.getElementById('progress-pct');
    const progressBar = document.getElementById('progress-bar');
    const submitBtn = document.getElementById('submit-btn');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeTrack = data.hasGate ? null : Object.keys(data.tracks)[0];

    function trackInputs(trackKey) {
      return Array.from(form.querySelectorAll(`.assessment-input[data-track="${trackKey}"]`));
    }

    function updateProgress() {
      if (!activeTrack) return;
      const total = data.tracks[activeTrack].pillars.reduce((n, p) => n + p.count, 0);
      const answered = new Set(trackInputs(activeTrack).filter(i => i.checked).map(i => i.name)).size;
      const pct = Math.round((answered / total) * 100);
      progressLabel.textContent = `${answered} of ${total} answered`;
      progressPct.textContent = `${pct}%`;
      progressBar.style.width = `${pct}%`;
    }

    function selectTrack(trackKey) {
      activeTrack = trackKey;
      window.__2ways?.track('assessment_start', { tool: data.slug, track: trackKey });
      document.getElementById('gate-fieldset')?.style.setProperty('display', 'none');
      document.querySelectorAll('.track-questions').forEach(el => {
        el.style.display = el.dataset.track === trackKey ? '' : 'none';
      });
      progressCard.style.display = '';
      submitBtn.style.display = '';
      updateProgress();
      progressCard.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
    }

    document.querySelectorAll('.gate-option').forEach(btn => {
      btn.addEventListener('click', () => selectTrack(btn.dataset.track));
    });

    document.querySelectorAll('.change-track-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        activeTrack = null;
        document.querySelectorAll('.track-questions').forEach(el => { el.style.display = 'none'; });
        progressCard.style.display = 'none';
        submitBtn.style.display = 'none';
        document.getElementById('gate-fieldset')?.style.setProperty('display', '');
        document.getElementById('gate-fieldset')?.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      });
    });

    form.addEventListener('change', updateProgress);
    updateProgress();

    // ---- Enterprise dashboard rendering: score gauge + pillar radar chart ----

    // Sets the canvas's backing resolution for crisp rendering at the
    // device's pixel ratio. Deliberately does not touch canvas.style —
    // display size is controlled by surrounding CSS so charts can scale
    // down responsively on narrow viewports instead of overflowing them.
    function sizeCanvas(canvas, cssSize) {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = cssSize * dpr;
      canvas.height = cssSize * dpr;
      const ctx = canvas.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return ctx;
    }

    function drawGauge(canvas, pct) {
      const size = 160;
      const ctx = sizeCanvas(canvas, size);
      const cx = size / 2, cy = size / 2, r = 62;
      ctx.clearRect(0, 0, size, size);

      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, 2 * Math.PI);
      ctx.strokeStyle = '#E2E8F0';
      ctx.lineWidth = 14;
      ctx.stroke();

      const start = -Math.PI / 2;
      const end = start + (pct / 100) * 2 * Math.PI;
      ctx.beginPath();
      ctx.arc(cx, cy, r, start, end);
      ctx.strokeStyle = '#FFC451';
      ctx.lineWidth = 14;
      ctx.lineCap = 'round';
      ctx.stroke();
    }

    // Greedily wraps text into lines no wider than maxWidth, using the
    // canvas context's current font for measurement.
    function wrapLabel(ctx, text, maxWidth) {
      const words = text.split(' ');
      const lines = [];
      let current = '';
      for (const word of words) {
        const test = current ? `${current} ${word}` : word;
        if (current && ctx.measureText(test).width > maxWidth) {
          lines.push(current);
          current = word;
        } else {
          current = test;
        }
      }
      if (current) lines.push(current);
      return lines;
    }

    // Draws the pillar radar using each pillar's own score/max fraction
    // (correct even if pillars ever have different question counts). The
    // canvas size is derived from the actual measured label widths (rather
    // than a fixed guess) so axis text — including long, unbreakable single
    // words — never gets clipped at the canvas edge, regardless of pillar
    // name length.
    function drawRadar(canvas, pillars, perPillar) {
      const r = 80, spokeGap = 16, lineHeight = 13, wrapWidth = 72, padding = 10;
      const font = '11px system-ui, -apple-system, sans-serif';

      const measureCtx = canvas.getContext('2d');
      measureCtx.font = font;
      const wrappedLabels = pillars.map(p => wrapLabel(measureCtx, p.name, wrapWidth));
      const maxLineWidth = Math.max(
        wrapWidth,
        ...wrappedLabels.flat().map(line => measureCtx.measureText(line).width)
      );
      const size = Math.ceil(2 * (r + spokeGap + maxLineWidth + padding));

      const wrap = document.getElementById('result-radar-wrap');
      if (wrap) wrap.style.maxWidth = size + 'px';

      const ctx = sizeCanvas(canvas, size);
      canvas.style.aspectRatio = '1 / 1';
      ctx.font = font;
      const cx = size / 2, cy = size / 2, n = pillars.length;
      ctx.clearRect(0, 0, size, size);

      const rings = 4;
      ctx.strokeStyle = '#E2E8F0';
      ctx.lineWidth = 1;
      for (let ring = 1; ring <= rings; ring++) {
        const rr = (r * ring) / rings;
        ctx.beginPath();
        for (let i = 0; i <= n; i++) {
          const angle = -Math.PI / 2 + (i % n) * ((2 * Math.PI) / n);
          const x = cx + rr * Math.cos(angle), y = cy + rr * Math.sin(angle);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      ctx.fillStyle = '#475569';
      for (let i = 0; i < n; i++) {
        const angle = -Math.PI / 2 + i * ((2 * Math.PI) / n);
        const x = cx + r * Math.cos(angle), y = cy + r * Math.sin(angle);
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(x, y);
        ctx.strokeStyle = '#E2E8F0';
        ctx.stroke();

        const lx = cx + (r + spokeGap) * Math.cos(angle), ly = cy + (r + spokeGap) * Math.sin(angle);
        ctx.textAlign = Math.abs(Math.cos(angle)) < 0.2 ? 'center' : (Math.cos(angle) > 0 ? 'left' : 'right');
        ctx.textBaseline = 'middle';
        const lines = wrappedLabels[i];
        const blockOffset = ((lines.length - 1) / 2) * lineHeight;
        lines.forEach((line, k) => {
          ctx.fillText(line, lx, ly - blockOffset + k * lineHeight);
        });
      }

      ctx.beginPath();
      for (let i = 0; i <= n; i++) {
        const idx = i % n;
        const { score, max } = perPillar[pillars[idx].key];
        const frac = max > 0 ? score / max : 0;
        const angle = -Math.PI / 2 + idx * ((2 * Math.PI) / n);
        const x = cx + r * frac * Math.cos(angle), y = cy + r * frac * Math.sin(angle);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.fillStyle = 'rgba(255, 196, 81, 0.35)';
      ctx.strokeStyle = '#0D1B2A';
      ctx.lineWidth = 2;
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#0D1B2A';
      for (let i = 0; i < n; i++) {
        const { score, max } = perPillar[pillars[i].key];
        const frac = max > 0 ? score / max : 0;
        const angle = -Math.PI / 2 + i * ((2 * Math.PI) / n);
        const x = cx + r * frac * Math.cos(angle), y = cy + r * frac * Math.sin(angle);
        ctx.beginPath();
        ctx.arc(x, y, 3, 0, 2 * Math.PI);
        ctx.fill();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!activeTrack) return;

      const track = data.tracks[activeTrack];
      const perPillar = {};
      track.pillars.forEach(p => { perPillar[p.key] = { score: 0, max: p.count * 3 }; });

      let total = 0;
      track.pillars.forEach(p => {
        for (let i = 0; i < p.count; i++) {
          const name = `${activeTrack}__${p.key}-${i}`;
          const checked = form.querySelector(`input[name="${name}"]:checked`);
          const val = checked ? parseInt(checked.value, 10) : 0;
          perPillar[p.key].score += val;
          total += val;
        }
      });

      const band = track.bands.find(b => total >= b.min && total <= b.max) || track.bands[0];
      const overallPct = Math.round((total / track.maxScore) * 100);

      document.getElementById('result-pct').textContent = `${overallPct}%`;
      document.getElementById('result-score').textContent = `${total}/${track.maxScore} points`;
      document.getElementById('result-band').textContent = band.name;
      document.getElementById('result-blurb').textContent = band.blurb;
      document.getElementById('result-cta').href = `${data.base}${band.cta}`;
      document.getElementById('result-cta').textContent = 'Explore the recommended next step';

      drawGauge(document.getElementById('result-gauge'), overallPct);
      drawRadar(document.getElementById('result-radar'), track.pillars, perPillar);

      const breakdown = document.getElementById('result-breakdown');
      breakdown.innerHTML = '';
      track.pillars.forEach(p => {
        const { score, max } = perPillar[p.key];
        const cell = document.createElement('div');
        cell.innerHTML = `
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">${p.name}</p>
          <p class="mt-1 text-lg font-bold tabular-nums" style="color:#0D1B2A;">${score}<span class="text-sm font-normal text-slate-400">/${max}</span></p>
        `;
        breakdown.appendChild(cell);
      });

      document.getElementById('email-score-field').value = `${total}/${track.maxScore}`;
      document.getElementById('email-band-field').value = band.name;

      window.__2ways?.track('assessment_complete', {
        tool: data.slug,
        track: activeTrack,
        band: band.name,
        score_pct: overallPct
      });

      form.classList.add('hidden');
      document.getElementById('results').classList.remove('hidden');
      document.getElementById('results').scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    });

    document.getElementById('retake-btn')?.addEventListener('click', () => {
      form.reset();
      document.getElementById('results').classList.add('hidden');
      form.classList.remove('hidden');
      if (data.hasGate) {
        activeTrack = null;
        document.querySelectorAll('.track-questions').forEach(el => { el.style.display = 'none'; });
        progressCard.style.display = 'none';
        submitBtn.style.display = 'none';
        document.getElementById('gate-fieldset')?.style.setProperty('display', '');
      } else {
        updateProgress();
      }
      form.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    });

    const emailForm = document.getElementById('results-email-form');
    emailForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = emailForm.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        await fetch(emailForm.action, {
          method: 'POST',
          body: new FormData(emailForm),
          headers: { Accept: 'application/json' }
        });
        // The actual lead event — an identifiable contact, not just a visit.
        window.__2ways?.track('lead_email_submit', { source: 'assessment', tool: data.slug });
        emailForm.classList.add('hidden');
        document.getElementById('email-sent-msg').classList.remove('hidden');
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Email my result';
      }
    });
  </script>
</BaseLayout>
