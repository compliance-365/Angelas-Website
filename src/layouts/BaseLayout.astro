---
import '../styles/global.css';  // <-- THIS makes Tailwind apply globally
import { SITE } from '../config/site';

const {
  title = SITE.title,
  description = SITE.description,
  canonical = SITE.url,
  schema,
  ogImage = SITE.ogImage
} = Astro.props;

const base = import.meta.env.BASE_URL;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<html lang="en" class="min-h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}brand/logo-icon.svg`} type="image/svg+xml" />

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}${ogImage}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}${ogImage}`} />

    {schemaList.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-full bg-white text-slate-900 antialiased">
    <slot name="header" />
    <main><slot /></main>
    <slot name="footer" />
  </body>
</html>
