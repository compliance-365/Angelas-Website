---
import '../styles/global.css';  // <-- THIS makes Tailwind apply globally
import { SITE } from '../config/site';
import AcknowledgementOfCountry from '../components/AcknowledgementOfCountry.astro';
import CookieNotice from '../components/CookieNotice.astro';

const {
  title = SITE.title,
  description = SITE.description,
  canonical = SITE.url,
  schema,
  ogImage = SITE.ogImage
} = Astro.props;

const base = import.meta.env.BASE_URL;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<html lang="en" class="min-h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}brand/logo.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Poppins:wght@300;400;500;600;700&family=Raleway:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}${ogImage}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}${ogImage}`} />

    {schemaList.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-19R2JCRJ9Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-19R2JCRJ9Y');
    </script>

    <!-- Apollo website visitor tracker -->
    <script is:inline>
      function initApollo(){
        var n = Math.random().toString(36).substring(7),
            o = document.createElement('script');
        o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n;
        o.async = true; o.defer = true;
        o.onload = function(){ window.trackingFunctions.onLoad({ appId: '6909a2cbe5d2c0001134df57' }); };
        document.head.appendChild(o);
      }
      initApollo();
    </script>
  </head>
  <body class="min-h-full antialiased bg-brand text-ink font-sans">
    <slot name="header" />
    <main><slot /></main>
    <slot name="footer" />
    <AcknowledgementOfCountry />
    <CookieNotice />
  </body>
</html>
