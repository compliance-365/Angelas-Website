---
import AssessmentTool from '../layouts/AssessmentTool.astro';

// ---- Track: no RAP yet ----
// Structured around Reconciliation Australia's four RAP pillars, so the
// result maps onto real, recognised categories rather than an arbitrary quiz.
const gettingStartedPillars = [
  {
    key: 'relationships',
    name: 'Relationships',
    questions: [
      'Has your organisation built genuine relationships with Aboriginal and Torres Strait Islander peoples, communities or organisations?',
      'Do you have a process for ongoing, respectful engagement with Aboriginal and Torres Strait Islander stakeholders?',
      'Does your organisation participate in National Reconciliation Week or NAIDOC Week activities?'
    ]
  },
  {
    key: 'respect',
    name: 'Respect',
    questions: [
      'Have staff completed cultural awareness or cultural competency training?',
      "Are cultural protocols — such as Acknowledgement of Country — embedded in everyday practice?",
      "Does your organisation recognise and celebrate Aboriginal and Torres Strait Islander cultures, histories and knowledge?"
    ]
  },
  {
    key: 'opportunities',
    name: 'Opportunities',
    questions: [
      'Does your organisation have strategies or targets for Aboriginal and Torres Strait Islander employment?',
      'Do you track or grow your spend with Aboriginal and Torres Strait Islander-owned businesses?',
      'Are there pathways for Aboriginal and Torres Strait Islander staff into leadership roles?'
    ]
  },
  {
    key: 'governance',
    name: 'Governance',
    questions: [
      'Does senior leadership actively sponsor and champion reconciliation work?',
      'Is there a dedicated RAP working group or committee with clear accountability?',
      'Do you monitor and report progress against reconciliation commitments — for example, to a board?'
    ]
  }
];

// 12 questions × 3 max = 36. Bands are baselined directly on Reconciliation
// Australia's four RAP types (Reflect, Innovate, Stretch, Elevate) as a
// directional guide to which stage an organisation is best positioned for —
// the AssessmentTool disclaimer makes clear this isn't a formal RAP type
// determination, which only Reconciliation Australia can award.
const gettingStartedBands = [
  { min: 0, max: 9, name: 'Reflect', blurb: "Your organisation is at the Reflect stage of the reconciliation journey — the right starting point for building internal understanding, relationships and governance before committing to bigger actions.", cta: 'services/rap/' },
  { min: 10, max: 18, name: 'Innovate', blurb: 'Your organisation has real foundations in place and is well positioned for an Innovate RAP — turning good intentions into a structured, accountable plan with clear owners, timelines and evidence.', cta: 'services/rap/' },
  { min: 19, max: 27, name: 'Stretch', blurb: "You're well progressed across most pillars and positioned for a Stretch RAP — embedding practice more deeply, with a stronger focus on measurable outcomes and accountability.", cta: 'services/monitoring-evaluation/' },
  { min: 28, max: 36, name: 'Elevate', blurb: "You're demonstrating leading practice across relationships, respect, opportunities and governance — positioned for Elevate, with a focus on sector leadership and deepening employment and procurement impact.", cta: 'services/employment-workplace/' }
];

// ---- Tracks: already have a RAP (Reflect / Innovate / Stretch / Elevate) ----
// Each stage gets its own question set, not a shared generic one — what
// "readiness to progress" looks like is genuinely different depending on
// where an organisation already is. Asking a Stretch-stage organisation
// "have you done any cultural training" wastes the chance to ask something
// actually relevant to them.

// Reflect → Innovate: tests whether foundational scoping work is solid
// enough to formalise into a structured, resourced plan.
const reflectPillars = [
  {
    key: 'relationships',
    name: 'Relationships',
    questions: [
      'Have you identified the specific Aboriginal and Torres Strait Islander stakeholders and organisations relevant to your operations?',
      'Has engagement moved beyond a one-off introduction to regular, ongoing contact?',
      "Have you scoped potential partnership opportunities, even if none are formalised yet?"
    ]
  },
  {
    key: 'respect',
    name: 'Respect',
    questions: [
      'Have staff completed at least an introductory cultural awareness session?',
      'Has your organisation started developing cultural protocols, such as Acknowledgement of Country practices?',
      'Have you researched the histories and cultures of the Traditional Owners of the land you operate on?'
    ]
  },
  {
    key: 'opportunities',
    name: 'Opportunities',
    questions: [
      'Have you identified potential areas for Aboriginal and Torres Strait Islander employment or procurement in your business?',
      'Have you begun reviewing your current recruitment and procurement practices for barriers?',
      'Have you identified internal champions to help progress these opportunities?'
    ]
  },
  {
    key: 'governance',
    name: 'Governance',
    questions: [
      'Has your RAP working group been formally established, with clear terms of reference?',
      'Has senior leadership formally endorsed your reconciliation commitments?',
      'Do you have a realistic timeline and resourcing plan to move from Reflect to Innovate?'
    ]
  }
];

// Innovate → Stretch: tests whether piloted approaches are being embedded
// organisation-wide with real measurement, not just tried once.
const innovatePillars = [
  {
    key: 'relationships',
    name: 'Relationships',
    questions: [
      'Are your Aboriginal and Torres Strait Islander partnerships now formalised — for example, through agreements or ongoing programs?',
      'Have relationships expanded beyond your initial contacts to a broader network?',
      "Is community input shaping your organisation's broader strategy, not just RAP-specific activities?"
    ]
  },
  {
    key: 'respect',
    name: 'Respect',
    questions: [
      'Is cultural competency training mandatory and ongoing for all staff, rather than a one-off pilot group?',
      'Have cultural protocols been embedded into standard business processes — events, communications, onboarding?',
      'Does your organisation actively contribute to public reconciliation initiatives beyond internal activities?'
    ]
  },
  {
    key: 'opportunities',
    name: 'Opportunities',
    questions: [
      'Have you implemented — not just planned — employment or procurement initiatives with measurable results?',
      'Are you actively tracking progress against the specific targets set in your Innovate RAP?',
      'Have you identified barriers to opportunities and taken concrete action to address them?'
    ]
  },
  {
    key: 'governance',
    name: 'Governance',
    questions: [
      'Is RAP progress reported regularly to senior leadership or the board, not just at renewal time?',
      'Has RAP accountability been embedded into position descriptions or performance measures?',
      'Do you have a system for capturing and reporting evidence against your RAP commitments?'
    ]
  }
];

// Stretch → Elevate: tests for genuine, sustained impact and governance
// sophisticated enough to support sector leadership.
const stretchPillars = [
  {
    key: 'relationships',
    name: 'Relationships',
    questions: [
      'Do you have long-term, multi-year partnerships with Aboriginal and Torres Strait Islander organisations delivering mutual benefit?',
      'Are Aboriginal and Torres Strait Islander partners involved in governance or advisory roles within your organisation?',
      "Does your organisation influence or support reconciliation efforts across your industry or sector?"
    ]
  },
  {
    key: 'respect',
    name: 'Respect',
    questions: [
      'Has cultural competency become part of your organisational culture — reflected in values, behaviours and leadership expectations?',
      'Does your organisation contribute to public discourse or education on reconciliation?',
      "Are Aboriginal and Torres Strait Islander histories and perspectives reflected in your organisation's core products, services or communications?"
    ]
  },
  {
    key: 'opportunities',
    name: 'Opportunities',
    questions: [
      'Have you achieved significant, sustained improvements in Aboriginal and Torres Strait Islander employment or procurement outcomes?',
      'Is there Aboriginal and Torres Strait Islander representation in senior leadership or on your board?',
      'Are your outcomes recognised externally — for example through awards, case studies or industry recognition?'
    ]
  },
  {
    key: 'governance',
    name: 'Governance',
    questions: [
      "Is reconciliation governance integrated into your organisation's core strategic and risk frameworks?",
      'Do you publicly and transparently report on both successes and shortcomings in your RAP journey?',
      'Does your organisation mentor or support other organisations on their reconciliation journeys?'
    ]
  }
];

// Elevate: there's no further formal RAP stage, so this tests depth and
// sustainability of leading practice rather than readiness to progress.
const elevatePillars = [
  {
    key: 'relationships',
    name: 'Relationships',
    questions: [
      "Are your partnerships self-sustaining and mutually led, rather than dependent on your organisation's ongoing initiation?",
      "Have you helped other organisations build their own relationships with Aboriginal and Torres Strait Islander communities?",
      'Is your organisation seen as a trusted partner by Aboriginal and Torres Strait Islander communities beyond your immediate operations?'
    ]
  },
  {
    key: 'respect',
    name: 'Respect',
    questions: [
      'Does your organisation help shape sector-wide standards or policy on cultural safety and respect?',
      'Have your Elevate practices been sustained through leadership changes or organisational restructuring?',
      'Do you invest in developing the next generation of reconciliation leaders within your organisation?'
    ]
  },
  {
    key: 'opportunities',
    name: 'Opportunities',
    questions: [
      'Are your employment and procurement outcomes sustained over multiple years, not just a single reporting period?',
      'Have you influenced supply chains or industry practices beyond your own organisation?',
      'Do you actively support the growth of Aboriginal and Torres Strait Islander businesses beyond your own direct procurement?'
    ]
  },
  {
    key: 'governance',
    name: 'Governance',
    questions: [
      'Is your reconciliation governance regularly reviewed and refreshed to stay ambitious, rather than steady-state?',
      'Do you contribute learnings from your RAP journey to sector bodies, government or Reconciliation Australia?',
      "Is your organisation recognised as a benchmark or reference point for other organisations' RAPs?"
    ]
  }
];

const stageMeta: Record<string, { current: string; next: string | null; cta: string }> = {
  reflect: { current: 'Reflect', next: 'Innovate', cta: 'services/rap/' },
  innovate: { current: 'Innovate', next: 'Stretch', cta: 'services/monitoring-evaluation/' },
  stretch: { current: 'Stretch', next: 'Elevate', cta: 'services/employment-workplace/' },
  elevate: { current: 'Elevate', next: null, cta: 'contact/' }
};

function deepeningBands(meta: { current: string; next: string | null; cta: string }) {
  if (meta.next) {
    return [
      { min: 0, max: 9, name: `Early in ${meta.current}`, blurb: `You're still consolidating the basics of your ${meta.current} RAP. Before looking toward ${meta.next}, it's worth focusing on embedding what's already committed to — deepening relationships, training and governance rather than adding new commitments.`, cta: meta.cta },
      { min: 10, max: 18, name: `Progressing through ${meta.current}`, blurb: `You're making solid progress within ${meta.current}. Keep building — closing the remaining gaps here will put you in a strong position to plan your ${meta.next} RAP.`, cta: meta.cta },
      { min: 19, max: 27, name: `Well-positioned for ${meta.next}`, blurb: `You've embedded ${meta.current} practice well and are showing genuine readiness signals for ${meta.next} — it's a good time to start scoping what a ${meta.next} RAP would involve.`, cta: meta.cta },
      { min: 28, max: 36, name: `Ready for ${meta.next}`, blurb: `You're exceeding what's typically expected at ${meta.current} and showing strong, embedded practice across all four pillars. You're a strong candidate to begin your ${meta.next} RAP now.`, cta: meta.cta }
    ];
  }
  // Elevate has no further formal RAP stage — framing shifts to sustaining
  // and sector leadership rather than "progressing to the next stage".
  return [
    { min: 0, max: 9, name: 'Early in Elevate', blurb: "You're still consolidating Elevate-level practice. Focus on deepening and embedding your existing commitments before looking at what comes next.", cta: meta.cta },
    { min: 10, max: 18, name: 'Progressing through Elevate', blurb: "You're making solid progress at Elevate level. Keep building toward consistent, embedded practice across all four pillars.", cta: meta.cta },
    { min: 19, max: 27, name: 'Strong Elevate practice', blurb: "You're demonstrating strong, embedded Elevate practice. From here, consider a focus on sector leadership — mentoring other organisations or sharing your approach publicly.", cta: meta.cta },
    { min: 28, max: 36, name: 'Exemplary practice', blurb: "You're demonstrating exemplary, embedded practice across all four pillars. Consider formalising your role as a sector leader — mentoring, speaking, or helping shape best practice for others.", cta: meta.cta }
  ];
}

const gate = {
  question: 'Does your organisation currently have a Reconciliation Action Plan?',
  options: [
    { value: 'getting-started', label: "No, we don't have a RAP yet" },
    { value: 'reflect', label: 'Yes — we have a Reflect RAP' },
    { value: 'innovate', label: 'Yes — we have an Innovate RAP' },
    { value: 'stretch', label: 'Yes — we have a Stretch RAP' },
    { value: 'elevate', label: 'Yes — we have an Elevate RAP' }
  ]
};

const tracks = {
  'getting-started': { pillars: gettingStartedPillars, bands: gettingStartedBands },
  reflect: { pillars: reflectPillars, bands: deepeningBands(stageMeta.reflect) },
  innovate: { pillars: innovatePillars, bands: deepeningBands(stageMeta.innovate) },
  stretch: { pillars: stretchPillars, bands: deepeningBands(stageMeta.stretch) },
  elevate: { pillars: elevatePillars, bands: deepeningBands(stageMeta.elevate) }
};

const disclaimer = "This is a general guide to help you plan your next step, not a formal RAP type determination — Reconciliation Australia assesses and approves the specific RAP type your organisation registers for.";
---
<AssessmentTool
  slug="assessment"
  pageTitle="Free RAP Readiness Assessment"
  metaDescription="A free, 5-minute self-assessment against the four RAP pillars — Relationships, Respect, Opportunities and Governance — tailored to whether you're just starting out or already progressing a RAP."
  kicker="Free tool · Takes about 5 minutes"
  heroTitle="RAP Readiness Assessment"
  heroIntro="Whether you're just starting out or already have a RAP in place, tell us where you're starting from and we'll ask the right questions — then give you an instant, personalised read on what's next for your organisation."
  gate={gate}
  tracks={tracks}
  emailSubject="RAP Readiness Assessment result"
  disclaimer={disclaimer}
  crossLink={{ label: 'Indigenous Procurement Readiness Check', href: 'procurement-readiness/' }}
/>
