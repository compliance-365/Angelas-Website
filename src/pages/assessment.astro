---
import AssessmentTool from '../layouts/AssessmentTool.astro';

// Structured around Reconciliation Australia's four RAP pillars, so the
// result maps onto real, recognised categories rather than an arbitrary quiz.
const pillars = [
  {
    key: 'relationships',
    name: 'Relationships',
    questions: [
      'Has your organisation built genuine relationships with Aboriginal and Torres Strait Islander peoples, communities or organisations?',
      'Do you have a process for ongoing, respectful engagement with Aboriginal and Torres Strait Islander stakeholders?',
      'Does your organisation participate in National Reconciliation Week or NAIDOC Week activities?'
    ]
  },
  {
    key: 'respect',
    name: 'Respect',
    questions: [
      'Have staff completed cultural awareness or cultural competency training?',
      "Are cultural protocols — such as Acknowledgement of Country — embedded in everyday practice?",
      "Does your organisation recognise and celebrate Aboriginal and Torres Strait Islander cultures, histories and knowledge?"
    ]
  },
  {
    key: 'opportunities',
    name: 'Opportunities',
    questions: [
      'Does your organisation have strategies or targets for Aboriginal and Torres Strait Islander employment?',
      'Do you track or grow your spend with Aboriginal and Torres Strait Islander-owned businesses?',
      'Are there pathways for Aboriginal and Torres Strait Islander staff into leadership roles?'
    ]
  },
  {
    key: 'governance',
    name: 'Governance',
    questions: [
      'Does senior leadership actively sponsor and champion reconciliation work?',
      'Is there a dedicated RAP working group or committee with clear accountability?',
      'Do you monitor and report progress against reconciliation commitments — for example, to a board?'
    ]
  }
];

// 12 questions × 3 max = 36. Bands are baselined directly on Reconciliation
// Australia's four RAP types (Reflect, Innovate, Stretch, Elevate) as a
// directional guide to which stage an organisation is best positioned for —
// the AssessmentTool disclaimer makes clear this isn't a formal RAP type
// determination, which only Reconciliation Australia can award.
const bands = [
  { min: 0, max: 9, name: 'Reflect', blurb: "Your organisation is at the Reflect stage of the reconciliation journey — the right starting point for building internal understanding, relationships and governance before committing to bigger actions.", cta: 'services/rap/' },
  { min: 10, max: 18, name: 'Innovate', blurb: 'Your organisation has real foundations in place and is well positioned for an Innovate RAP — turning good intentions into a structured, accountable plan with clear owners, timelines and evidence.', cta: 'services/rap/' },
  { min: 19, max: 27, name: 'Stretch', blurb: "You're well progressed across most pillars and positioned for a Stretch RAP — embedding practice more deeply, with a stronger focus on measurable outcomes and accountability.", cta: 'services/monitoring-evaluation/' },
  { min: 28, max: 36, name: 'Elevate', blurb: "You're demonstrating leading practice across relationships, respect, opportunities and governance — positioned for Elevate, with a focus on sector leadership and deepening employment and procurement impact.", cta: 'services/employment-workplace/' }
];

const disclaimer = "This is a general guide to help you plan your next step, not a formal RAP type determination — Reconciliation Australia assesses and approves the specific RAP type your organisation registers for.";
---
<AssessmentTool
  slug="assessment"
  pageTitle="Free RAP Readiness Assessment"
  metaDescription="A free, 5-minute self-assessment against the four RAP pillars — Relationships, Respect, Opportunities and Governance — mapped to the Reflect, Innovate, Stretch and Elevate RAP stages."
  kicker="Free tool · Takes about 5 minutes"
  heroTitle="RAP Readiness Assessment"
  heroIntro="12 quick questions across the four RAP pillars — Relationships, Respect, Opportunities and Governance — used by Reconciliation Australia. Get an instant, personalised read on which RAP stage — Reflect, Innovate, Stretch or Elevate — your organisation is best positioned for next."
  pillars={pillars}
  bands={bands}
  emailSubject="RAP Readiness Assessment result"
  disclaimer={disclaimer}
  crossLink={{ label: 'Indigenous Procurement Readiness Check', href: 'procurement-readiness/' }}
/>
