---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../config/site';

const base = import.meta.env.BASE_URL;

// File sizes are read at build time so they can never drift from the actual
// files the way a hardcoded label would.
function fileSize(name: string) {
  const bytes = fs.statSync(path.join(process.cwd(), 'public', 'templates', name)).size;
  return `${Math.round(bytes / 1024)} KB`;
}

const templates = [
  {
    icon: 'doc',
    name: 'RAP Action Register',
    file: 'rap-action-register.xlsx',
    format: 'Excel',
    phase: 'Phase 4 — Design',
    body: 'Every commitment with a named owner, deliverable, timeframe, measure and evidence source. Includes a summary tab that calculates delivery status by pillar, and flags any action with no owner named.',
    contains: [
      'Action register with dropdown validation for pillar and status',
      'Auto-calculating summary by status and by pillar',
      'A count of actions with no owner — the ones that will slip',
      'A worked example row showing the expected level of specificity'
    ]
  },
  {
    icon: 'users',
    name: 'RAP Working Group Terms of Reference',
    file: 'rap-working-group-terms-of-reference.docx',
    format: 'Word',
    phase: 'Phase 2 — Foundation',
    body: 'A terms of reference template that forces the three things most working groups leave vague: actual decision-making authority, a named executive sponsor, and a real budget figure.',
    contains: [
      'Authority section with specific delegated powers, not general aspirations',
      'Executive sponsor accountability, including whether it sits in their performance measures',
      'A section on genuine Aboriginal and Torres Strait Islander participation, including remuneration',
      'Guidance notes explaining why each section matters, which you delete before circulating'
    ]
  },
  {
    icon: 'chart',
    name: 'RAP Evidence Tracker',
    file: 'rap-evidence-tracker.xlsx',
    format: 'Excel',
    phase: 'Phase 6 — Delivery',
    body: 'A running log of the proof behind your commitments, captured as work happens. Includes a coverage tab showing which actions currently have no evidence logged at all.',
    contains: [
      'Evidence log linked to your action register by Action ID',
      'Coverage view flagging commitments you currently cannot prove',
      'Verification fields, so a second person confirms the evidence supports the claim',
      'Prompts to store files somewhere durable rather than in an inbox'
    ]
  }
];

const faqs = [
  {
    q: 'Are these templates really free?',
    a: 'Yes. No email required, no sign-up, no watermark. Download them, adapt them, put your own branding on them. We publish our full delivery methodology for the same reason — an organisation running a RAP well without us is a better outcome than one running it badly with us.'
  },
  {
    q: 'Can we adapt these for our organisation?',
    a: 'Yes, that is the intent. They are deliberately generic starting points. Every organisation will need to adjust the pillar structure, add fields relevant to their context, and change the governance sections to match how they actually make decisions.'
  },
  {
    q: 'Do these replace working with a consultant?',
    a: 'For some organisations, genuinely yes. Templates handle structure. What they cannot do is tell you honestly whether the RAP type you have chosen is achievable, facilitate community engagement respectfully, or challenge a commitment that sounds good but cannot be delivered. Those are the three places outside judgement is worth most.'
  },
  {
    q: 'Will you review our completed register?',
    a: 'Yes — get in touch. Reviewing a draft action register is a common small piece of work, and it is usually the cheapest way to find out whether your commitments are specific enough to survive review and delivery.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free Reconciliation Action Plan templates',
  itemListElement: templates.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: t.name,
      description: t.body,
      url: `${SITE.url}/templates/${t.file}`,
      isAccessibleForFree: true,
      provider: { '@id': `${SITE.url}/#organization` }
    }
  }))
};
---
<BaseLayout
  title={`Free RAP Templates: Action Register, Terms of Reference, Evidence Tracker | ${SITE.name}`}
  description="Three free Reconciliation Action Plan templates — an action register, a working group terms of reference, and an evidence tracker. No email required. Built from the delivery framework we use on real engagements."
  canonical={`${SITE.url}/rap-templates/`}
  schema={[listSchema, faqSchema]}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero
    kicker="Free resources · No email required"
    title="RAP templates you can actually use"
    intro="Three working documents from the delivery framework we run engagements on — the action register, the working group terms of reference, and the evidence tracker. Download them, adapt them, keep them."
    breadcrumbs={[{ label: 'RAP templates' }]}
  />

  <!-- TEMPLATES -->
  <section class="section">
    <div class="grid gap-6">
      {templates.map((t) => (
        <div class="grid-card">
          <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-start">
            <div>
              <div class="flex items-center gap-3">
                <span class="icon-soft"><Icon name={t.icon as any} size={20} /></span>
                <div>
                  <h2 class="font-semibold text-lg">{t.name}</h2>
                  <p class="text-xs text-white/50 mt-0.5">
                    {t.format} &middot; {fileSize(t.file)} &middot; {t.phase}
                  </p>
                </div>
              </div>
              <p class="mt-4 text-sm text-white/75 leading-relaxed">{t.body}</p>
              <ul class="mt-4 grid gap-2">
                {t.contains.map((c) => (
                  <li class="flex items-start gap-2.5 text-sm text-white/70">
                    <span class="mt-0.5 shrink-0 text-brand-light"><Icon name="check" size={16} /></span>
                    <span class="leading-relaxed">{c}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={`${base}templates/${t.file}`}
              class="btn shrink-0 md:mt-1"
              download
              data-download={t.file}
            >
              Download
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY FREE -->
  <section class="light-section">
    <div class="section max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Why these are free</h2>
      <p class="mt-4 text-slate-700 leading-relaxed">
        Most Reconciliation Action Plans do not fail because the organisation lacked a good template. They fail
        because commitments had no owner, engagement stopped after the first meeting, or evidence was never captured
        as the work happened.
      </p>
      <p class="mt-3 text-slate-700 leading-relaxed">
        Templates fix the first of those. Structure is genuinely useful, and there is no reason to charge for it or
        put it behind an email form. If these help your organisation deliver a RAP well without us, that is a better
        outcome for reconciliation than the alternative.
      </p>
      <p class="mt-3 text-slate-700 leading-relaxed">
        They pair with our <a href={`${base}rap-delivery-framework/`} class="underline" style="color:#8a6a1f;">published delivery framework</a>,
        which sets out the full six-phase methodology, the artefacts produced at each phase, and the specific way
        each phase tends to go wrong.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}rap-delivery-framework/`} class="btn">Read the delivery framework</a>
        <a href={`${base}assessment/`} class="btn-outline !text-slate-700 !border-slate-300">Take the free assessment</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section max-w-3xl">
    <p class="kicker">Questions</p>
    <FAQ faqs={faqs} heading="About these templates" emitSchema={false} />
  </section>

  <CTASection
    title="Want us to review your completed register?"
    body="Reviewing a draft action register is a small, common piece of work — and usually the cheapest way to find out whether your commitments are specific enough to survive both review and delivery."
    primaryLabel="Get in touch"
    primaryHref="contact/"
    secondaryLabel="See how we work"
    secondaryHref="how-we-work/"
  />

  <Fragment slot="footer"><Footer /></Fragment>

  <script is:inline>
    document.querySelectorAll('a[data-download]').forEach((a) => {
      a.addEventListener('click', () => {
        window.__2ways?.track('resource_download', { file: a.getAttribute('data-download') });
      });
    });
  </script>
</BaseLayout>
