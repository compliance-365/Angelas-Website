---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../config/site';

const base = import.meta.env.BASE_URL;

// File sizes are read at build time so they can never drift from the actual
// files the way a hardcoded label would.
function fileSize(name: string) {
  const bytes = fs.statSync(path.join(process.cwd(), 'public', 'templates', name)).size;
  return `${Math.round(bytes / 1024)} KB`;
}

const templates = [
  {
    icon: 'doc',
    name: 'RAP Action Register',
    file: 'rap-action-register.xlsx',
    format: 'Excel',
    body: 'A blank register for recording the commitments in your RAP — one row per action, with columns for owner, deliverable, timeframe, measure and evidence source.',
    contains: [
      'Thirteen columns covering owner, deliverable, dates, measure and evidence source',
      'Dropdown validation on the pillar and status columns',
      'Formatted and ready for up to 120 actions'
    ]
  },
  {
    icon: 'users',
    name: 'RAP Working Group Terms of Reference',
    file: 'rap-working-group-terms-of-reference.docx',
    format: 'Word',
    body: 'A blank terms of reference for a RAP Working Group, laid out with the sections these documents normally carry and a fill-in field for each one.',
    contains: [
      'Nine sections, from purpose and authority through to review',
      'Tables ready to complete for sponsor, membership, meetings and approval',
      'Bracketed prompts marking every field you need to fill in'
    ]
  },
  {
    icon: 'chart',
    name: 'RAP Evidence Tracker',
    file: 'rap-evidence-tracker.xlsx',
    format: 'Excel',
    body: 'A blank log for recording the proof behind your commitments, keyed to your action register by Action ID.',
    contains: [
      'Nine columns covering evidence type, description, location and verification',
      'Dropdown validation on the evidence type column',
      'Links back to your action register by Action ID'
    ]
  }
];

const faqs = [
  {
    q: 'Are these templates really free?',
    a: 'Yes. No email required, no sign-up, no watermark. They are blank starting structures — download them, adapt them, and put your own branding on them.'
  },
  {
    q: 'Can we adapt these for our organisation?',
    a: 'Yes, that is the intent. They are deliberately generic starting points. Every organisation will need to adjust the pillar structure, add fields relevant to their context, and change the governance sections to match how they actually make decisions.'
  },
  {
    q: 'Do these replace working with a consultant?',
    a: 'No. These give you the structure — the columns, the sections, the fields. What a blank template cannot do is tell you whether the RAP type you have chosen is achievable, help you word a commitment so it can actually be delivered and evidenced, facilitate community engagement respectfully, or judge whether what you have written will survive review. That is the work we do with clients.'
  },
  {
    q: 'Will you help us fill them in?',
    a: 'Yes — get in touch. Working through a draft action register with you is a common small piece of work, and it is usually the cheapest way to find out whether your commitments are specific enough to survive both review and delivery.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free Reconciliation Action Plan templates',
  itemListElement: templates.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: t.name,
      description: t.body,
      url: `${SITE.url}/templates/${t.file}`,
      isAccessibleForFree: true,
      provider: { '@id': `${SITE.url}/#organization` }
    }
  }))
};
---
<BaseLayout
  title={`Free RAP Templates: Action Register, Terms of Reference, Evidence Tracker | ${SITE.name}`}
  description="Three free blank Reconciliation Action Plan templates — an action register, a working group terms of reference, and an evidence tracker. No email required."
  canonical={`${SITE.url}/rap-templates/`}
  schema={[listSchema, faqSchema]}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero
    kicker="Free resources · No email required"
    title="Blank RAP templates to start from"
    intro="Three documents most RAPs need — an action register, a working group terms of reference, and an evidence tracker. Blank and ready to complete. Download them, adapt them, keep them."
    breadcrumbs={[{ label: 'RAP templates' }]}
  />

  <!-- TEMPLATES -->
  <section class="section">
    <div class="grid gap-6">
      {templates.map((t) => (
        <div class="grid-card">
          <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-start">
            <div>
              <div class="flex items-center gap-3">
                <span class="icon-soft"><Icon name={t.icon as any} size={20} /></span>
                <div>
                  <h2 class="font-semibold text-lg">{t.name}</h2>
                  <p class="text-xs text-white/50 mt-0.5">
                    {t.format} &middot; {fileSize(t.file)}
                  </p>
                </div>
              </div>
              <p class="mt-4 text-sm text-white/75 leading-relaxed">{t.body}</p>
              <ul class="mt-4 grid gap-2">
                {t.contains.map((c) => (
                  <li class="flex items-start gap-2.5 text-sm text-white/70">
                    <span class="mt-0.5 shrink-0 text-brand-light"><Icon name="check" size={16} /></span>
                    <span class="leading-relaxed">{c}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={`${base}templates/${t.file}`}
              class="btn shrink-0 md:mt-1"
              download
              data-download={t.file}
            >
              Download
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY FREE -->
  <section class="light-section">
    <div class="section max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Why these are free</h2>
      <p class="mt-4 text-slate-700 leading-relaxed">
        A blank template is structure, and structure is not the hard part of a Reconciliation Action Plan. There is
        no reason to charge for it or put it behind an email form.
      </p>
      <p class="mt-3 text-slate-700 leading-relaxed">
        Most RAPs do not fall over because the spreadsheet had the wrong columns. They fall over because a
        commitment was written in a way nobody could deliver, an action was owned by a team rather than a person, or
        evidence was left until reporting was due. Those are judgement calls made while the plan is being written,
        and they are what we work on with clients.
      </p>
      <p class="mt-3 text-slate-700 leading-relaxed">
        If these get you started, use them. If you want a second read on what you have filled in,
        <a href={`${base}contact/`} class="underline" style="color:#8a6a1f;">talk to us</a>.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}how-we-work/`} class="btn">See how we work</a>
        <a href={`${base}assessment/`} class="btn-outline !text-slate-700 !border-slate-300">Take the free assessment</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section max-w-3xl">
    <p class="kicker">Questions</p>
    <FAQ faqs={faqs} heading="About these templates" emitSchema={false} />
  </section>

  <CTASection
    title="Want us to review your completed register?"
    body="Reviewing a draft action register is a small, common piece of work — and usually the cheapest way to find out whether your commitments are specific enough to survive both review and delivery."
    primaryLabel="Get in touch"
    primaryHref="contact/"
    secondaryLabel="See how we work"
    secondaryHref="how-we-work/"
  />

  <Fragment slot="footer"><Footer /></Fragment>

  <script is:inline>
    document.querySelectorAll('a[data-download]').forEach((a) => {
      a.addEventListener('click', () => {
        window.__2ways?.track('resource_download', { file: a.getAttribute('data-download') });
      });
    });
  </script>
</BaseLayout>
