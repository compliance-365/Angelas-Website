---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../config/site';
import { PHASES, PRINCIPLES } from '../data/deliveryFramework';

const base = import.meta.env.BASE_URL;

// Phase names and outcomes only — the underlying method is not published, so
// there are no HowToDirection steps to emit here. See deliveryFramework.ts.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'The 2Ways RAP Delivery Framework',
  description:
    'A six-phase approach to developing and delivering a Reconciliation Action Plan, covering readiness, governance foundation, community engagement, commitment design, Reconciliation Australia endorsement, and delivery with evidence capture.',
  step: PHASES.map((p, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: p.name,
    text: p.outcome
  }))
};
---
<BaseLayout
  title={`The RAP Delivery Framework | ${SITE.name}`}
  description="Our six-phase approach to delivering a Reconciliation Action Plan — readiness, foundation, engagement, design, endorsement and delivery — and what your organisation has at the end of each phase."
  canonical={`${SITE.url}/rap-delivery-framework/`}
  schema={schema}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero
    kicker="Methodology"
    title="The RAP Delivery Framework"
    intro="Six phases, from an honest readiness assessment through to evidence captured across the term. This is the shape of how we run engagements, and what you have in hand at the end of each phase."
    breadcrumbs={[{ label: 'RAP Delivery Framework' }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`${base}assessment/`} class="btn">Start with a readiness check</a>
      <a href={`${base}contact/`} class="btn-outline">Talk through your situation</a>
    </div>
  </PageHero>

  <!-- WHY -->
  <section class="section max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-semibold">Why a framework at all</h2>
    <div class="prose mt-4">
      <p>
        Most Reconciliation Action Plans do not fail at the writing stage. They fail eighteen months later, when an
        organisation discovers that commitments had no owner, that engagement stopped after the first meeting, or
        that work genuinely was delivered but nobody recorded it.
      </p>
      <p>
        Those are not unlucky outcomes — they are <strong>predictable</strong>, and each one traces back to a
        specific phase where something was skipped. Working to a defined sequence, with a clear test for whether
        each phase is actually finished, is what stops a plan drifting into that position.
      </p>
      <p>
        The outline below is the sequence we work to, and what your organisation has at the end of each phase.
      </p>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">Constants</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">Four rules that hold across every phase</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-8">
      {PRINCIPLES.map((p) => (
        <div class="grid-card">
          <h3 class="font-semibold leading-snug">{p.title}</h3>
          <p class="mt-2 text-sm text-white/70 leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PHASE OVERVIEW -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">Overview</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">The six phases</h2>
    </div>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[480px] border-separate border-spacing-0 rounded-2xl overflow-hidden text-sm">
        <thead>
          <tr>
            <th class="text-left p-4 bg-surface font-semibold text-brand-light">Phase</th>
            <th class="text-left p-4 bg-surface font-semibold text-brand-light">Purpose</th>
          </tr>
        </thead>
        <tbody>
          {PHASES.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white/5' : 'bg-white/[0.02]'}>
              <td class="p-4 align-top whitespace-nowrap">
                <a href={`#${p.id}`} class="font-semibold text-brand-light hover:underline">{p.number} &middot; {p.name}</a>
              </td>
              <td class="p-4 align-top text-white/75">{p.purpose}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- PHASE DETAIL -->
  <section class="section">
    <div class="grid gap-6 md:grid-cols-2">
      {PHASES.map((p) => (
        <article id={p.id} class="grid-card scroll-mt-24">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <span class="text-3xl font-extrabold tabular-nums text-brand-light/50">{p.number}</span>
            <h2 class="text-xl font-semibold">{p.name}</h2>
          </div>
          <p class="mt-4 text-white/80 leading-relaxed">{p.purpose}.</p>
          <div class="mt-5 rounded-xl border border-brand-light/20 bg-brand-light/[0.05] p-5">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-brand-light">What you have at the end</h3>
            <p class="mt-2 text-sm text-white/75 leading-relaxed">{p.outcome}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- WHERE WE COME IN -->
  <section class="light-section">
    <div class="section max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Where we come in</h2>
      <p class="mt-4 text-slate-700 leading-relaxed">
        The sequence above is the easy part to describe. The work sits in the judgement calls inside each phase —
        deciding honestly which RAP type is achievable, knowing when a phase is genuinely finished rather than just
        out of time, facilitating community engagement respectfully, and challenging commitments that sound good but
        cannot be delivered.
      </p>
      <p class="mt-3 text-slate-700 leading-relaxed">
        That is what we bring to an engagement, alongside the detailed working method behind each phase — the
        activities, the artefacts, and the specific checks that tell you a phase can be closed.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}assessment/`} class="btn">Start with the free readiness check</a>
        <a href={`${base}services/rap/`} class="btn-outline !text-slate-700 !border-slate-300">RAP consulting overview</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Want this run for you?"
    body="A free discovery call covers Phase 1 in outline — which RAP type is realistic for your organisation, and what delivering it would involve."
    primaryLabel="Book a discovery call"
    primaryHref="contact/"
    secondaryLabel="See how we work"
    secondaryHref="how-we-work/"
  />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
