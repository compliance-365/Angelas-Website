---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

const base = import.meta.env.BASE_URL;

// RAP pricing supplied by Angela — indicative ranges, not fixed quotes. The
// bands are ranges rather than "from" figures on purpose: the spread reflects
// how hands-on the engagement is, which is what the note under the table says.
const rapSizes = ['Small organisation (<50 staff)', 'Medium organisation (50–250 staff)', 'Large / Corporate / Enterprise'];
const rapTypes = [
  { name: 'Reflect', duration: '12 or 18 months', prices: ['$5,000–$12,000', '$12,000–$25,000', '$25,000–$45,000+'] },
  { name: 'Innovate', duration: '2 years', prices: ['$12,000–$25,000', '$25,000–$50,000', '$50,000–$90,000+'] },
  { name: 'Stretch', duration: '3 years', prices: ['$20,000–$35,000', '$40,000–$75,000', '$75,000–$130,000+'] },
  { name: 'Elevate', duration: '3 years', prices: ['Request a quote', 'Request a quote', 'Request a quote'] }
];

// Cultural Competence eLearning licence pricing. Real figures — keep in sync
// with the training page, which shows the same table alongside the module
// detail. The per-seat rate must descend down the table; see the note on the
// training page for why the original figures didn't.
const elearningLicences = [
  { tier: 'Single user', price: '$290', perSeat: '$290' },
  { tier: 'Up to 10 users', price: '$2,700', perSeat: '$270' },
  { tier: 'Up to 25 users', price: '$6,250', perSeat: '$250' },
  { tier: 'Up to 50 users', price: '$11,750', perSeat: '$235' },
  { tier: 'Up to 100 users', price: '$22,110', perSeat: '$221' }
];

// PLACEHOLDER PRICING — the figures in this block are illustrative, not real
// costing, and still need confirming. The RAP table above is real.
const packages = [
  {
    name: 'Business & Strategic Planning',
    from: '$7,500',
    href: 'services/business-strategic/',
    includes: ['Organisational health check', 'Strategic roadmap', 'Policy & procedure review']
  },
  {
    name: 'Employment & Workplace',
    from: '$9,000',
    href: 'services/employment-workplace/',
    includes: ['Employment pathway strategy', 'Cultural safety review', 'Anti-racism framework']
  },
  {
    name: 'Monitoring & Evaluation',
    from: '$5,500',
    href: 'services/monitoring-evaluation/',
    includes: ['Evaluation framework design', 'Quarterly reporting setup', 'Impact assessment']
  }
];

const faqs = [
  {
    q: 'Why aren’t your prices fixed?',
    a: 'Every engagement scopes differently depending on your organisation’s size, current maturity, and what’s already in place. The figures here are starting points for typical engagements — we confirm exact scope and pricing after a short discovery call.'
  },
  {
    q: 'What affects the cost of a RAP?',
    a: 'Mainly two things: your organisation’s size, and which RAP type you’re developing. A Reflect RAP is a smaller, more contained engagement than a Stretch or Elevate RAP, which involve deeper governance, broader stakeholder engagement, and more extensive evidence and reporting requirements.'
  },
  {
    q: 'Is the discovery call free?',
    a: 'Yes — there’s no cost or obligation to talk through your situation and get an indicative quote.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<BaseLayout
  title={`Pricing | ${SITE.name}`}
  description="Indicative pricing for Reconciliation Action Plans and our other services, scaled by organisation size and scope. Get a tailored quote after a free discovery call."
  canonical={`${SITE.url}/pricing/`}
  schema={faqSchema}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 hero-pattern"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 md:py-20 text-center">
      <p class="kicker">Pricing</p>
      <h1 class="mt-3 text-3xl md:text-5xl font-extrabold text-white leading-tight">Straightforward, scaled to your organisation</h1>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">
        The figures below are starting points for typical engagements, not fixed quotes — cost scales with your
        organisation's size and what's already in place. We'll confirm exact scope and pricing on a free discovery call.
      </p>
    </div>
  </section>

  <!-- RAP PRICING GRID -->
  <section class="section">
    <h2 class="text-2xl font-semibold">Reconciliation Action Plans</h2>
    <p class="mt-2 text-white/70 max-w-2xl">Pricing scales with your organisation's size, which RAP level you're developing, and how much of the delivery you want us to carry.</p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[820px] border-separate border-spacing-0 rounded-2xl overflow-hidden">
        <thead>
          <tr>
            <th class="text-left p-4 bg-surface font-semibold text-brand-light">RAP level</th>
            <th class="text-left p-4 bg-surface font-semibold text-brand-light">RAP duration</th>
            {rapSizes.map((size) => (
              <th class="text-left p-4 bg-surface font-semibold text-brand-light">{size}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rapTypes.map((type, i) => (
            <tr class={i % 2 === 0 ? 'bg-white/5' : 'bg-white/[0.02]'}>
              <td class="p-4 font-semibold">{type.name}</td>
              <td class="p-4 text-white/75 whitespace-nowrap">{type.duration}</td>
              {type.prices.map((price) => (
                <td class={`p-4 ${price.startsWith('$') ? 'tabular-nums whitespace-nowrap' : 'text-white/50'}`}>{price}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-white/70 max-w-3xl leading-relaxed">
      Figures are per year of engagement with your organisation, not a single fee covering the full RAP duration
      shown above.
    </p>
    <p class="mt-3 text-sm text-white/70 max-w-3xl leading-relaxed">
      Indicative pricing is based on the level of support required, ranging from a hands-off advisory approach to a
      hands-on delivery approach. An initial assessment of the organisation's current RAP health, readiness and
      internal capability will determine the final scope and pricing.
    </p>
    <p class="mt-3 text-xs text-white/50">All prices in AUD, exclusive of GST.</p>

    <a href={`${base}contact/`} class="btn mt-6 inline-flex">Get a tailored RAP quote</a>
  </section>

  <!-- CULTURAL COMPETENCE ELEARNING -->
  <section class="section">
    <h2 class="text-2xl font-semibold">Cultural competence eLearning</h2>
    <p class="mt-2 text-white/70 max-w-2xl">
      The three-module series, licensed for a year and priced by how many people need access. Full module breakdown
      is on the <a href={`${base}services/cultural-awareness-training/`} class="underline">training page</a>.
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[520px] max-w-2xl border-separate border-spacing-0 rounded-2xl overflow-hidden text-left">
        <thead>
          <tr>
            <th class="p-4 bg-surface font-semibold text-brand-light">Individual and team access</th>
            <th class="p-4 bg-surface font-semibold text-brand-light text-right">Per person</th>
            <th class="p-4 bg-surface font-semibold text-brand-light text-right">Investment</th>
          </tr>
        </thead>
        <tbody>
          {elearningLicences.map((l, i) => (
            <tr class={i % 2 === 0 ? 'bg-white/5' : 'bg-white/[0.02]'}>
              <td class="p-4">{l.tier}</td>
              <td class="p-4 text-right tabular-nums whitespace-nowrap text-white/50">{l.perSeat}</td>
              <td class="p-4 text-right font-semibold tabular-nums whitespace-nowrap">{l.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-white/50">
      One-year licences covering all three modules. AUD, exclusive of GST. For more than 100 users, or to own the
      program outright, <a href={`${base}contact/`} class="underline">get in touch</a>.
    </p>
  </section>

  <!-- OTHER SERVICES -->
  <section class="light-section">
    <div class="section">
      <h2 class="text-2xl font-semibold text-slate-900">Other services</h2>
      <p class="mt-2 text-slate-600 max-w-2xl">Indicative starting prices for a typical engagement. Final pricing depends on scope.</p>

      <div class="grid md:grid-cols-2 gap-6 mt-6">
        {packages.map((pkg) => (
          <div class="grid-card !bg-white text-slate-900">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-semibold text-lg">{pkg.name}</h3>
              <span class="text-lg font-bold tabular-nums whitespace-nowrap" style="color:#0D1B2A;">From {pkg.from}</span>
            </div>
            <ul class="mt-3 space-y-1 text-sm text-slate-600 list-disc pl-5">
              {pkg.includes.map((item) => <li>{item}</li>)}
            </ul>
            <a href={`${base}${pkg.href}`} class="mt-4 inline-block text-sm underline" style="color:#0D1B2A;">Learn more about this service &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="section">
    <h2 class="text-2xl font-semibold">Included in every engagement</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 mt-6">
      {[
        'Indigenous-led delivery',
        'A named point of contact throughout',
        'Progress tracking and reporting',
        'Post-engagement support'
      ].map((item) => (
        <div class="grid-card text-center">
          <p class="text-sm font-medium">{item}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <h2 class="text-2xl font-semibold">Pricing FAQs</h2>
    <div class="mt-6 grid gap-4">
      {faqs.map((f) => (
        <details class="p-4 border border-white/10 rounded-xl">
          <summary class="font-semibold cursor-pointer">{f.q}</summary>
          <p class="mt-2 text-sm text-white/80">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="cta-banner">
      <div>
        <h3 class="text-xl font-semibold">Not sure what you need yet?</h3>
        <p class="text-sm">Take the free RAP Readiness Assessment first, or book a no-obligation discovery call.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn bg-brand text-white hover:opacity-90" href={`${base}assessment/`}>Free assessment</a>
        <a class="btn-outline" href={`${base}contact/`}>Talk to us</a>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
