---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { SERVICES } from '../data/services';

const base = import.meta.env.BASE_URL;
const params = new URLSearchParams(Astro.url.search);
const isSuccess = params.get('success') === '1';

// Driven by the same SERVICES list as the header, footer and homepage grid,
// so a service that's added or removed there can't leave this checklist
// stale — which is exactly what happened to the hardcoded list this
// replaced: it kept offering a service removed months earlier, and never
// gained RAP Health Check, Cultural Awareness Training or Indigenous
// Procurement as they were added.
const interests = [...SERVICES.map((s) => s.name), 'Other'];
---
<BaseLayout
  title={`Contact | ${SITE.name}`}
  description="Start a conversation about your RAP, cultural capability training, or workplace inclusion goals."
  canonical={`${SITE.url}/contact/`}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">

    {isSuccess ? (
      <div class="grid-card p-6 md:p-8 text-center">
        <div class="mx-auto h-12 w-12 rounded-full flex items-center justify-center bg-brand-light text-brand">
          ✓
        </div>
        <h1 class="mt-4 text-2xl md:text-3xl font-extrabold text-white">Thanks — we've got your message</h1>
        <p class="mt-2 text-white/70">We'll come back to you shortly.</p>
        <div class="mt-6 flex justify-center gap-3">
          <a href={`${base}services/rap/`} class="btn-outline">Explore RAP services</a>
          <a href={`${base}`} class="btn">Back to home</a>
        </div>
      </div>
    ) : (
      <div class="grid md:grid-cols-[0.95fr_1.05fr] gap-6 items-start">

        <aside class="grid-card">
          <h2 class="kicker mb-2">Contact</h2>
          <h1 class="text-3xl md:text-4xl font-extrabold text-white leading-tight">Partner with us to turn intent into impact.</h1>
          <p class="mt-5 text-white/80">
            Tell us about your goals and context and we'll recommend the best next step — whether that's a RAP
            discovery conversation, workplace inclusion planning, or cultural capability training.
          </p>

          <div class="mt-6 grid gap-3">
            <span class="pill-strong w-max">Indigenous-owned</span>
            <span class="pill w-max">Supply Nation registered</span>
          </div>

          <div class="mt-8 text-sm text-white/80 space-y-1">
            <p>{SITE.address}</p>
            <p><a href={`mailto:${SITE.email}`} class="underline">{SITE.email}</a></p>
          </div>
        </aside>

        <div class="grid-card !bg-white text-slate-900 p-4 md:p-6 lg:p-7">
          <h2 class="text-2xl md:text-[26px] font-extrabold">Enquiry form</h2>
          <p class="mt-1 text-sm text-slate-600">Fields marked * are required.</p>

          <form
            id="contact-form"
            action="https://formspree.io/f/xgvwovew"
            method="POST"
            class="mt-4 grid gap-4"
          >
            <input type="hidden" name="_subject" value="2Ways Website Enquiry" />
            <input type="hidden" name="_redirect" value={`${SITE.url}/contact/?success=1`} />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="page_url" value={`${SITE.url}/contact/`} />

            <fieldset class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium mb-1">First name*</label>
                <input name="firstName" required class="w-full border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-light" />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Last name*</label>
                <input name="lastName" required class="w-full border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-light" />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Work email*</label>
                <input type="email" name="email" required class="w-full border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-light" />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Phone</label>
                <input name="phone" class="w-full border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-light" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-sm font-medium mb-1">Organisation*</label>
                <input name="company" required class="w-full border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-light" />
              </div>
            </fieldset>

            <div class="mt-1">
              <h3 class="text-lg font-semibold">What do you need help with?</h3>
              <p class="text-sm text-slate-600">Select all that apply.</p>
              <div class="mt-3 grid md:grid-cols-2 gap-y-2 gap-x-6 text-sm">
                {interests.map((label) => (
                  <label class="inline-flex items-center gap-2"><input type="checkbox" name="interest" value={label} /> {label}</label>
                ))}
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium mb-1">Tell us a little about your goals</label>
              <textarea name="message" rows="6" class="w-full border rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-light" placeholder="e.g., Current stage; priorities; any deadlines; who should be involved…"></textarea>
            </div>

            <div class="flex items-start gap-3 text-sm">
              <input type="checkbox" id="consent" required class="mt-1.5">
              <label for="consent">
                I agree to be contacted about my enquiry and understand this form stores my submitted information in accordance with the
                <a href={`${base}privacy/`} class="underline">privacy policy</a>.
              </label>
            </div>

            <div class="pt-1">
              <button id="submitBtn" class="btn inline-flex items-center gap-2" type="submit">
                <span id="btnText">Send enquiry</span>
                <svg id="spinner" class="hidden animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 0 1 8-8" stroke="currentColor" stroke-width="4"></path></svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    )}
  </section>

  <Fragment slot="footer"><Footer /></Fragment>

  <script is:inline>
    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', () => {
        window.__2ways?.track('contact_form_submit', { source: 'contact_page' });
        const btn = document.getElementById('submitBtn');
        const txt = document.getElementById('btnText');
        const spin = document.getElementById('spinner');
        btn.setAttribute('disabled', 'true');
        spin.classList.remove('hidden');
        txt.textContent = 'Sending…';
      });
    }
  </script>
</BaseLayout>
