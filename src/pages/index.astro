---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

const base = import.meta.env.BASE_URL;

const services = [
  {
    name: 'Reconciliation Action Plans (RAP)',
    blurb: 'Enhancing cultural awareness and enabling reconciliation within your organisation through strategic and actionable plans.',
    href: 'services/rap/'
  },
  {
    name: 'Business and Strategic Planning',
    blurb: 'Expert guidance and strategic support to help organisations achieve their business objectives and sustainable growth.',
    href: 'services/business-strategic/'
  },
  {
    name: 'Employment and Workplace',
    blurb: 'Empowering workplaces to build inclusive, culturally safe environments that attract, support, and retain Aboriginal and Torres Strait Islander peoples.',
    href: 'services/employment-workplace/'
  },
  {
    name: 'Monitoring and Evaluation',
    blurb: 'Comprehensive analysis and assessment to enhance cultural intelligence and build inclusive practices.',
    href: 'services/monitoring-evaluation/'
  },
  {
    name: 'Diversity and Inclusion Programs',
    blurb: 'Fostering a more inclusive and equitable workplace through targeted initiatives and strategic support.',
    href: 'services/diversity-inclusion/'
  }
];

const stats = [
  { value: '35', label: 'Reconciliation Action Plans', sub: 'guided and supported across diverse sectors' },
  { value: '210', label: 'Cultural Competence Workshops', sub: 'delivered to organisations of all sizes' },
  { value: '1,500', label: 'Hours of Consulting Support', sub: 'provided to clients for sustainable outcomes' },
  { value: '98%', label: 'Client Satisfaction Rate', sub: 'reflecting our commitment to excellence' }
];

const testimonials = [
  { quote: 'Working with 2Ways Consulting has been a game-changer for our organisation. Their expertise in cultural awareness training and strategic planning helped us foster a more inclusive and productive workplace.', role: 'HR Manager', org: 'Utilities' },
  { quote: "The Reconciliation Action Plan developed by 2Ways Consulting has been instrumental in guiding our company's efforts towards reconciliation. Their professional approach and comprehensive support made the entire process seamless.", role: 'Procurement Manager', org: 'Government Agency' },
  { quote: "The consultancy services provided by 2Ways Consulting have exceeded our expectations. Their team's ability to deliver customised solutions tailored to our specific needs was impressive and highly valuable.", role: 'Project Manager', org: 'Construction' },
  { quote: "2Ways Consulting's training programs have significantly enhanced my understanding of cultural dynamics in the workplace. Their expert guidance has empowered me to navigate diverse cultural settings with confidence.", role: 'Freelancer', org: 'Creative Industry' },
  { quote: 'The insights and strategies provided by 2Ways Consulting have been invaluable for my business. Their commitment to promoting cultural awareness and reconciliation is truly commendable.', role: 'Entrepreneur', org: 'Retail' }
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/brand/logo.png`,
  foundingLocation: 'Brisbane, Australia',
  areaServed: 'AU',
  sameAs: SITE.sameAs,
  description: SITE.description
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  canonical={`${SITE.url}/`}
  schema={[orgSchema, webSiteSchema]}
>
  <Fragment slot="header"><Header /></Fragment>

  <!-- HERO -->
  <section id="hero" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand via-brand to-surface"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-24 md:py-32 text-center">
      <p class="kicker">Indigenous Australian–led</p>
      <h1 class="mt-3 text-4xl md:text-6xl font-extrabold leading-[1.1] text-white">
        Enhance Your Cultural Intelligence with Our Services
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-white/80 md:text-lg">
        We offer professional consultancy and training to help your organisation excel in reconciliation and
        culturally diverse settings.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={`${base}contact/`} class="btn">Get Started Today</a>
        <a href="#services" class="btn-outline">Check our Services</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-xs text-white/80">
        <span class="inline-flex items-center gap-2 bg-white/10 rounded-full px-3 py-2 backdrop-blur-sm">
          <img src={`${base}brand/supply-nation-registered.png`} alt="" class="h-5 w-5 object-contain" />
          Supply Nation Registered
        </span>
        <span class="inline-flex items-center gap-2 bg-white/10 rounded-full px-3 py-2 backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-brand-light"></span> Brisbane-based, Australia-wide
        </span>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section">
    <h2 class="text-2xl font-semibold">Our Services</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-6">
      {services.map((s) => (
        <a class="stage-card p-6 card-raise" href={`${base}${s.href}`}>
          <h3 class="font-semibold">{s.name}</h3>
          <p class="mt-2 text-sm text-white/80">{s.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- STATS -->
  <section class="light-section">
    <div class="section">
      <h2 class="text-2xl font-semibold">Our Achievements</h2>
      <p class="mt-2 max-w-2xl text-slate-600">
        We pride ourselves on delivering exceptional results for our clients. Here are some of our key achievements
        and statistics that highlight our impact and success.
      </p>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6 mt-8">
        {stats.map((s) => (
          <div class="grid-card !bg-white text-center">
            <p class="text-3xl font-extrabold" style="color:#0D1B2A;">{s.value}</p>
            <p class="mt-1 font-semibold text-sm" style="color:#0D1B2A;">{s.label}</p>
            <p class="mt-1 text-xs text-slate-600">{s.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section">
    <h2 class="text-2xl font-semibold">What Our Clients Say</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-6">
      {testimonials.map((t) => (
        <blockquote class="stage-card p-6">
          <p class="text-sm text-white/90">&ldquo;{t.quote}&rdquo;</p>
          <footer class="mt-3 text-sm text-brand-light">{t.role} &mdash; {t.org}</footer>
        </blockquote>
      ))}
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="section">
    <div class="cta-banner" id="contact">
      <div>
        <h3 class="text-xl font-semibold">Take Your First Step Towards Cultural Excellence</h3>
        <p class="text-sm">Join organisations making a positive impact through cultural awareness and reconciliation.</p>
      </div>
      <a class="btn bg-brand text-white hover:opacity-90" href={`${base}contact/`}>Get Started Now</a>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
