---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../config/site';
import { RAP_TYPES } from '../data/rapTypes';
import { SERVICES } from '../data/services';
import { CASE_STUDIES } from '../data/caseStudies';

const base = import.meta.env.BASE_URL;

// Problems stated the way buyers actually describe them internally, rather
// than as service names — this is the section that earns the scroll.
const problems = [
  {
    icon: 'compass',
    title: '“We want a RAP but don’t know where to start.”',
    body: 'Leadership has committed, but nobody internally has run a RAP before. You need someone who knows what Reconciliation Australia expects before you spend twelve months finding out.'
  },
  {
    icon: 'clock',
    title: '“Our RAP has stalled.”',
    body: 'The document exists. The working group meets. But actions keep slipping, evidence isn’t being captured, and nobody is confident you could show real progress at renewal.'
  },
  {
    icon: 'scale',
    title: '“We need to meet procurement and tender requirements.”',
    body: 'Government and enterprise contracts increasingly ask what you’re doing on reconciliation and Indigenous procurement. You need something genuine, not a box-tick that won’t survive scrutiny.'
  }
];

const services = SERVICES;

// Ported from the live site (2waysconsultancy.com.au) — real figures, not
// invented. Keep in sync if the business updates them.
const stats = [
  { value: '35', label: 'Reconciliation Action Plans', sub: 'guided across diverse sectors' },
  { value: '210', label: 'Cultural competence workshops', sub: 'delivered to organisations of all sizes' },
  { value: '1,500', label: 'Hours of consulting support', sub: 'provided to clients for lasting outcomes' },
  { value: '98%', label: 'Client satisfaction rate', sub: 'reflecting our commitment to excellence' }
];

const testimonials = [
  {
    quote: 'The Reconciliation Action Plan developed by 2Ways has been instrumental in guiding our company’s efforts towards reconciliation. Their professional approach and comprehensive support made the entire process seamless.',
    role: 'Procurement Manager',
    org: 'Government Agency'
  },
  {
    quote: 'Working with 2Ways has been a game-changer for our organisation. Their expertise in cultural awareness training and strategic planning helped us foster a more inclusive and productive workplace.',
    role: 'HR Manager',
    org: 'Utilities'
  },
  {
    quote: 'The consultancy services provided by 2Ways have exceeded our expectations. Their team’s ability to deliver customised solutions tailored to our specific needs was impressive and highly valuable.',
    role: 'Project Manager',
    org: 'Construction'
  }
];

const faqs = [
  {
    q: 'What is a Reconciliation Action Plan (RAP)?',
    a: 'A Reconciliation Action Plan is a formal, structured framework — administered by Reconciliation Australia — through which an organisation commits to specific, measurable actions that advance reconciliation. RAPs are built around four pillars: Relationships, Respect, Opportunities and Governance. There are four RAP types (Reflect, Innovate, Stretch and Elevate), each suited to a different stage of an organisation’s reconciliation journey.'
  },
  {
    q: 'Which type of RAP should our organisation start with?',
    a: 'Most organisations begin with a Reflect RAP, which runs for around 12 months and focuses on building the relationships, understanding and internal governance needed before committing to bigger actions. If your organisation already has strong relationships and internal capability, an Innovate RAP may be the right entry point. Our free RAP Readiness Assessment gives you a personalised indication in about five minutes.'
  },
  {
    q: 'How long does it take to develop a RAP?',
    a: 'Developing the plan itself can take anywhere from 12 months onward.'
  },
  {
    q: 'Do we have to use a consultant to develop a RAP?',
    a: 'No — organisations can develop a RAP directly with Reconciliation Australia’s published guidance and templates. Organisations engage consultants when they want Indigenous-led guidance on what commitments are genuine and achievable, help facilitating community and stakeholder engagement, and support avoiding the common pitfalls that cause RAPs to stall or come back with feedback.'
  },
  {
    q: 'What makes 2Ways Consultancy different?',
    a: 'We are a 100% Indigenous-owned business and Supply Nation registered. That means the cultural guidance in your RAP comes from lived experience rather than desk research — and that engaging us also contributes to your own Indigenous procurement outcomes.'
  }
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/brand/logo.png`,
  image: `${SITE.url}${SITE.ogImage}`,
  description: SITE.description,
  foundingLocation: 'Brisbane, Australia',
  areaServed: { '@type': 'Country', name: 'Australia' },
  sameAs: SITE.sameAs,
  knowsAbout: [
    'Reconciliation Action Plan',
    'Indigenous procurement',
    'Cultural awareness training',
    'Aboriginal and Torres Strait Islander employment',
    'Cultural safety'
  ],
  // Structured name/address for local SEO — keep in sync with SITE.address in
  // site.ts and whatever's entered on Google Business Profile / Bing Places so
  // the signals match. No telephone is published, by choice; email is the
  // contact channel, so don't reintroduce a `telephone` property here.
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brisbane',
    addressRegion: 'QLD',
    postalCode: '4000',
    addressCountry: 'AU'
  },
  email: SITE.email,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Consultancy services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.blurb }
    }))
  }
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  publisher: { '@id': `${SITE.url}/#organization` }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<BaseLayout
  title={SITE.title}
  description={SITE.description}
  canonical={`${SITE.url}/`}
  schema={[orgSchema, webSiteSchema, faqSchema]}
>
  <Fragment slot="header"><Header /></Fragment>

  <!-- HERO -->
  <section id="hero" class="relative overflow-hidden">
    <div class="absolute inset-0 hero-pattern"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="kicker">100% Indigenous-owned · Supply Nation registered</p>
        <h1 class="mt-4 text-4xl md:text-6xl font-extrabold leading-[1.08] text-white">
          Reconciliation Action Plans that hold up in practice
        </h1>
        <p class="mt-6 text-lg md:text-xl text-white/75 leading-relaxed">
          2Ways Consultancy helps Australian organisations plan, deliver and measure Reconciliation Action Plans —
          led by Aboriginal and Torres Strait Islander consultants, so your commitments are grounded in lived
          experience rather than good intentions.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={`${base}assessment/`} class="btn">Take the free RAP assessment</a>
          <a href={`${base}contact/`} class="btn-outline">Book a discovery call</a>
        </div>
        <p class="mt-4 text-sm text-white/50">Free · Five minutes · No obligation</p>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="border-y border-white/10 bg-surface/40">
    <div class="mx-auto max-w-6xl px-4 py-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/70">
      <span class="inline-flex items-center gap-2">
        <img src={`${base}brand/supply-nation-registered.png`} alt="" class="h-6 w-6 object-contain" />
        Supply Nation registered
      </span>
      <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-light"></span> 100% Indigenous-owned</span>
      <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-light"></span> Brisbane-based, working Australia-wide</span>
      <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-light"></span> ABN {SITE.abn}</span>
    </div>
  </section>

  <!-- PROBLEMS -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">Where organisations get stuck</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">You're probably here for one of three reasons</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      {problems.map((p) => (
        <div class="grid-card">
          <span class="icon-soft"><Icon name={p.icon as any} size={20} /></span>
          <h3 class="mt-4 font-semibold text-lg leading-snug">{p.title}</h3>
          <p class="mt-2 text-sm text-white/75 leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- RAP TYPES -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">The RAP framework</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">Four RAP types. Which one fits your organisation?</h2>
      <p class="mt-3 text-white/75">
        Reconciliation Australia administers four RAP types, each designed for a different stage of the journey.
        Starting at the right one matters — aiming too high stalls, aiming too low wastes a cycle.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-8">
      {RAP_TYPES.map((t) => (
        <a href={`${base}services/rap/${t.slug}/`} class="stage-card card-raise p-6 flex flex-col">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-semibold text-lg">{t.name}</h3>
            <span class="text-xs text-white/50 whitespace-nowrap">{t.duration}</span>
          </div>
          <p class="mt-2 text-sm text-white/75 flex-1 leading-relaxed">{t.shortFor}</p>
          <span class="link-arrow mt-4">Learn more <span data-arrow>&rarr;</span></span>
        </a>
      ))}
    </div>
    <div class="mt-6">
      <a href={`${base}services/rap/`} class="link-arrow">Compare all four RAP types in detail <span data-arrow>&rarr;</span></a>
    </div>
  </section>

  <!-- FREE TOOLS -->
  <section class="light-section">
    <div class="section">
      <p class="text-xs font-semibold uppercase tracking-wide" style="color:#8a6a1f;">Free · Five minutes · No obligation</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold text-slate-900">Get an instant read on where you stand</h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Two free self-assessment tools that score your organisation against the frameworks that actually matter, and
        tell you what the sensible next step is.
      </p>
      <div class="grid md:grid-cols-2 gap-6 mt-8">
        <div class="grid-card !bg-white text-slate-900 flex flex-col">
          <h3 class="font-semibold text-lg" style="color:#0D1B2A;">RAP Readiness Assessment</h3>
          <p class="mt-2 text-sm text-slate-600 flex-1">
            Scores you across Relationships, Respect, Opportunities and Governance — with different questions
            depending on whether you're starting out or already hold a Reflect, Innovate, Stretch or Elevate RAP.
          </p>
          <a class="btn mt-5 self-start" href={`${base}assessment/`}>Start the assessment</a>
        </div>
        <div class="grid-card !bg-white text-slate-900 flex flex-col">
          <h3 class="font-semibold text-lg" style="color:#0D1B2A;">Indigenous Procurement Readiness Check</h3>
          <p class="mt-2 text-sm text-slate-600 flex-1">
            Checks your procurement practice against the 2025–26 Indigenous Procurement Policy changes, including the
            51% ownership threshold that takes effect from 1 July 2026.
          </p>
          <a class="btn mt-5 self-start" href={`${base}procurement-readiness/`}>Start the check</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">What we do</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">Reconciliation work, end to end</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {services.map((s) => (
        <a
          class={`grid-card card-raise flex flex-col ${s.featured ? 'md:col-span-2 lg:col-span-1 border-brand-light/30' : ''}`}
          href={`${base}${s.href}`}
        >
          <span class="icon-soft"><Icon name={s.icon as any} size={20} /></span>
          <h3 class="mt-4 font-semibold text-lg">{s.name}</h3>
          {s.featured && <span class="pill mt-2 w-max">Core service</span>}
          <p class="mt-2 text-sm text-white/75 flex-1 leading-relaxed">{s.blurb}</p>
          <span class="link-arrow mt-4">Learn more <span data-arrow>&rarr;</span></span>
        </a>
      ))}
    </div>
    <div class="mt-8 grid-card border-brand-light/25">
      <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h3 class="font-semibold text-lg">How we deliver a RAP</h3>
          <p class="mt-2 text-sm text-white/75 max-w-2xl">
            Six phases, from an honest readiness assessment through to evidence captured across the term — and what
            your organisation has in hand at the end of each one.
          </p>
        </div>
        <a href={`${base}rap-delivery-framework/`} class="btn-outline shrink-0">See the framework</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section">
    <div class="rounded-2xl border border-white/10 bg-surface p-8 md:p-10">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((s) => (
          <div>
            <p class="stat-value">{s.value}</p>
            <p class="mt-2 font-semibold text-sm">{s.label}</p>
            <p class="mt-1 text-xs text-white/55 leading-relaxed">{s.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">Engagement examples</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">What a RAP engagement actually involves</h2>
      <p class="mt-3 text-white/75">
        Three shapes we see most often. These are illustrative examples rather than named client work — we publish
        client case studies only with written permission.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      {CASE_STUDIES.map((c) => (
        <a href={`${base}case-studies/${c.slug}/`} class="grid-card card-raise flex flex-col">
          <span class="pill w-max">{c.scenario}</span>
          <h3 class="mt-3 font-semibold text-lg leading-snug">{c.title}</h3>
          <p class="mt-2 text-sm text-white/75 flex-1 leading-relaxed">{c.summary}</p>
          <span class="link-arrow mt-4">Read the example <span data-arrow>&rarr;</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">What clients say</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">Trusted across government, utilities and construction</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      {testimonials.map((t) => (
        <figure class="grid-card flex flex-col">
          <span aria-hidden="true" class="text-4xl leading-none text-brand-light/40 font-serif">&ldquo;</span>
          <blockquote class="mt-1 text-sm text-white/85 flex-1 leading-relaxed">{t.quote}</blockquote>
          <figcaption class="mt-4 pt-4 border-t border-white/10 text-sm">
            <span class="font-semibold text-brand-light">{t.role}</span>
            <span class="text-white/55"> &mdash; {t.org}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section max-w-3xl">
    <p class="kicker">Common questions</p>
    <FAQ faqs={faqs} heading="Reconciliation Action Plans, explained" emitSchema={false} />
    <div class="mt-6">
      <a href={`${base}faq/`} class="link-arrow">See all frequently asked questions <span data-arrow>&rarr;</span></a>
    </div>
  </section>

  <CTASection />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
