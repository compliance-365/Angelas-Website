---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE } from '../../config/site';

const base = import.meta.env.BASE_URL;

// Newest first. Adding an article means adding an entry here plus the page.
const articles = [
  {
    slug: 'acknowledgement-vs-welcome-to-country',
    title: "Acknowledgement of Country vs Welcome to Country: what's the difference?",
    excerpt:
      'A Welcome to Country can only be delivered by Traditional Owners. An Acknowledgement can be offered by anyone. The distinction, who delivers each, and how to get it right.',
    date: 'August 2026',
    readTime: '5 min read',
    tag: 'Cultural protocol'
  },
  {
    slug: 'what-is-a-rap-working-group',
    title: 'What is a RAP Working Group, and what makes one actually work?',
    excerpt:
      'Most working groups stop meeting within eighteen months and the RAP stalls with them. The difference is rarely enthusiasm — it is structural, and it is decided at setup.',
    date: 'August 2026',
    readTime: '6 min read',
    tag: 'Governance'
  },
  {
    slug: 'planning-national-reconciliation-week-naidoc',
    title: 'Planning for National Reconciliation Week and NAIDOC Week',
    excerpt:
      'NRW is always 27 May to 3 June. A practical planning timeline working backwards, and how to avoid the morning-tea trap.',
    date: 'August 2026',
    readTime: '6 min read',
    tag: 'Planning guide'
  },
  {
    slug: 'reflect-vs-innovate-rap',
    title: 'Reflect or Innovate: which RAP should your organisation start with?',
    excerpt:
      'The first real decision in the RAP framework, and organisations get it wrong in both directions. A practical comparison, plus an honest test for whether you can skip Reflect.',
    date: 'August 2026',
    readTime: '5 min read',
    tag: 'Decision guide'
  },
  {
    slug: 'how-much-does-a-rap-cost',
    title: 'How much does a Reconciliation Action Plan cost?',
    excerpt:
      'Nobody publishes a flat price, which is frustrating when you need budget approved. Here is what actually drives the cost, and how to budget realistically before you request quotes.',
    date: 'August 2026',
    readTime: '6 min read',
    tag: "Buyer's guide"
  },
  {
    slug: 'indigenous-procurement-policy-changes',
    title: 'The Indigenous Procurement Policy is changing: what your organisation needs to know',
    excerpt:
      "From 1 July 2026, businesses must be at least 51% First Nations-owned to count toward Indigenous Procurement Policy targets — and the target itself is rising. Here's what's changing and what to do about it.",
    date: 'August 2026',
    readTime: '5 min read',
    tag: 'Policy update'
  }
];

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}/insights/${a.slug}/`,
    name: a.title
  }))
};
---
<BaseLayout
  title={`Insights: RAP & Indigenous Procurement Guidance | ${SITE.name}`}
  description="Practical guidance on Reconciliation Action Plans, Indigenous procurement and cultural capability — including RAP costs, choosing a RAP type, and the 2026 Indigenous Procurement Policy changes."
  canonical={`${SITE.url}/insights/`}
  schema={listSchema}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero
    kicker="Insights"
    title="Practical guidance, not just theory"
    intro="Policy changes, RAP delivery and cultural capability — explained plainly, by people who do this work."
    breadcrumbs={[{ label: 'Insights' }]}
  />

  <section class="section max-w-3xl">
    <div class="grid gap-6">
      {articles.map((a) => (
        <a href={`${base}insights/${a.slug}/`} class="grid-card card-raise block">
          <div class="flex flex-wrap items-center gap-3">
            <span class="pill">{a.tag}</span>
            <span class="text-xs text-white/50">{a.date} &middot; {a.readTime}</span>
          </div>
          <h2 class="mt-3 text-xl font-semibold leading-snug">{a.title}</h2>
          <p class="mt-2 text-sm text-white/75 leading-relaxed">{a.excerpt}</p>
          <span class="link-arrow mt-4">Read more <span data-arrow>&rarr;</span></span>
        </a>
      ))}
    </div>
  </section>

  <CTASection />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
