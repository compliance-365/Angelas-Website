---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config/site';

const base = import.meta.env.BASE_URL;

const articles = [
  {
    slug: 'indigenous-procurement-policy-changes',
    title: 'The Indigenous Procurement Policy is changing: what your organisation needs to know',
    excerpt: "From 1 July 2026, businesses must be at least 51% First Nations-owned to count toward Indigenous Procurement Policy targets — and the target itself is rising. Here's what's changing and what to do about it.",
    date: 'August 2026',
    readTime: '5 min read'
  }
];
---
<BaseLayout
  title={`Insights | ${SITE.name}`}
  description="Practical guidance on Reconciliation Action Plans, Indigenous procurement, and cultural capability — from 2Ways Consultancy."
  canonical={`${SITE.url}/insights/`}
>
  <Fragment slot="header"><Header /></Fragment>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 hero-pattern"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 md:py-20 text-center">
      <p class="kicker">Insights</p>
      <h1 class="mt-3 text-3xl md:text-5xl font-extrabold text-white leading-tight">Practical guidance, not just theory</h1>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">Policy changes, RAP delivery, and cultural capability — explained plainly.</p>
    </div>
  </section>

  <section class="section max-w-3xl">
    <div class="grid gap-6">
      {articles.map((a) => (
        <a href={`${base}insights/${a.slug}/`} class="grid-card card-raise block">
          <p class="text-xs text-white/50">{a.date} &middot; {a.readTime}</p>
          <h2 class="mt-1 text-xl font-semibold">{a.title}</h2>
          <p class="mt-2 text-sm text-white/80">{a.excerpt}</p>
          <span class="mt-3 inline-block text-sm text-brand-light underline">Read more &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
