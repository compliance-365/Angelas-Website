---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const howWeConduct = [
  { title: 'Authentic RAP development and strategy', body: "We partner with you to develop a RAP that aligns with your organisational values and contributes to tangible reconciliation outcomes." },
  { title: 'Structured RAP implementation roadmap', body: 'Our approach provides a clear, step-by-step methodology for implementing your RAP, ensuring practical and impactful actions are undertaken effectively.' },
  { title: 'Ongoing RAP support and guidance', body: 'We offer continuous support and expert advice throughout your RAP journey, helping your organisation navigate challenges and celebrate milestones.' },
  { title: 'Stakeholder engagement and collaboration', body: 'We assist in facilitating meaningful engagement with internal and external stakeholders, including Aboriginal and Torres Strait Islander communities, to ensure your RAP is authentic and inclusive.' },
  { title: 'Tracking progress and celebrating impact', body: 'We help you identify key indicators to track your progress and effectively demonstrate the positive impact of your RAP initiatives.' }
];
---
<ServiceLayout
  slug="services/rap"
  navTitle="Reconciliation Action Plans (RAP)"
  pageTitle="Reconciliation Action Plans (RAP)"
  metaDescription="Learn about our Reconciliation Action Plans (RAP) services and how we help organisations enhance cultural awareness and enable reconciliation."
  heroBlurb="Enhancing cultural awareness and enabling reconciliation within your organisation through strategic and actionable plans."
  whatIsHeading="What is a RAP?"
  whatIsBody="At 2Ways Consulting, our RAP implementation and support services guide your organisation through every stage of its reconciliation journey. We provide support with developing and embedding a meaningful RAP, ensuring it's not just a document, but a living commitment that drives genuine change and enables stronger relationships with Aboriginal and Torres Strait Islander peoples and communities."
  pullquote="RAPs are more than just documents; they are commitments to enabling understanding, respect, and positive relationships between Aboriginal and Torres Strait Islander peoples and the wider Australian community. Implementing a RAP demonstrates an organisation's dedication to making a lasting impact through cultural awareness and reconciliation."
  howWeConduct={howWeConduct}
  howWeHelp="At 2Ways Consulting, we are passionate about supporting organisations on their reconciliation journey by developing and implementing meaningful RAPs. We work with you to build inclusive, culturally safe, and respectful workplaces that value and empower Aboriginal and Torres Strait Islander peoples. Our RAP services are designed to enable genuine understanding, drive engagement, and embed sustainable change. If you're ready to develop a RAP that reflects your commitment to reconciliation and builds a more inclusive and respectful environment, we'd be delighted to partner with you."
  schemaDescription="End-to-end RAP planning, delivery, evidence and reporting, led by Indigenous consultants."
/>
