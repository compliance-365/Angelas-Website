---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE } from '../../config/site';

const base = import.meta.env.BASE_URL;

// The Cultural Competence eLearning Series, per Angela's program document.
// Module content, learning outcomes, interactive elements, program features
// and licence pricing all come from that document — do not embellish them
// here. The title cards in public/training/ are the module splash screens
// exported from the course itself.
const modules = [
  {
    number: '01',
    name: 'Our Shared Past',
    subtitle: 'Understanding Indigenous History and Impact',
    theme: 'Building awareness through truth-telling',
    image: 'training/module-1-our-shared-past.jpg',
    body: 'Establishes a foundational understanding of Aboriginal and Torres Strait Islander history, culture, and the legacy of colonisation. Learners are guided through thousands of years of cultural continuity and explore the disruptions caused by colonisation — from frontier violence to the Stolen Generations, and how these experiences continue to shape present-day realities.',
    sections: [
      ['Pre-colonial Indigenous societies', 'Sophisticated systems of law, trade, kinship and environmental management across 250+ Nations and 600+ dialects.'],
      ['Connection to Country', 'Understanding that Country is not just land — it holds identity, spirituality and belonging.'],
      ['Colonisation and its impacts', 'A visual timeline from 1788 to today, featuring the Stolen Generations, the 1967 Referendum, Mabo, and the Uluru Statement from the Heart.'],
      ['Intergenerational trauma', 'How loss, grief and disruption have affected communities, while recognising healing and resilience.'],
      ['Rights movements and activism', 'Leadership and courage through the 1938 Day of Mourning, William Cooper’s Petition, and the National Apology.']
    ],
    outcomes: [
      'Understand how history informs current relationships and inequities',
      'Recognise the resilience and resistance of Aboriginal and Torres Strait Islander peoples',
      'Reflect on personal and organisational responsibility in reconciliation'
    ],
    interactive: [
      'Animated timeline of key events',
      'Click-and-reveal activities on Language, Kinship and Country',
      'Reflection questions for personal connection to history'
    ]
  },
  {
    number: '02',
    name: 'Present Realities',
    subtitle: 'Navigating Contemporary Indigenous Australia',
    theme: 'Understanding current experiences and systems of inequity',
    image: 'training/module-2-present-realities.jpg',
    body: 'Builds on the historical foundation of Module 1 to explore the diversity, strength and contemporary realities of Aboriginal and Torres Strait Islander peoples today.',
    sections: [
      ['Diversity of cultures', 'Aboriginal and Torres Strait Islander peoples are not one homogeneous group — exploring cultural variations, languages and identity.'],
      ['Contemporary challenges', 'A data-driven look at health, education, housing and justice disparities, brought to life through infographics and reflection activities.'],
      ['Systemic racism and unconscious bias', 'How structural barriers and stereotypes influence workplace and community outcomes.'],
      ['Strength, resilience and contributions', 'Indigenous excellence across sport, arts, science, business and community leadership.'],
      ['Indigenous-led organisations and self-determination', 'Key bodies including NACCHO, NATSILS and the National Native Title Council, and the community-driven change they lead.']
    ],
    outcomes: [
      'Appreciate the ongoing diversity and vitality of Indigenous cultures',
      'Identify and challenge unconscious bias and systemic barriers',
      'Recognise how Indigenous-led organisations model self-determination',
      'Learn how facts and lived experience reveal the barriers and strengths in communities today'
    ],
    interactive: [
      'Knowledge quizzes and match-the-meaning activities',
      'Reflection prompts drawn from the data, not from abstractions',
      'Infographics visualising gaps in life expectancy, incarceration and education outcomes'
    ]
  },
  {
    number: '03',
    name: 'Towards a Shared Future',
    subtitle: 'Building Cultural Competence and Reconciliation',
    theme: 'From awareness to action',
    image: 'training/module-3-towards-a-shared-future.jpg',
    body: 'Translates knowledge into practice. Learners are equipped to become active participants in reconciliation and cultural safety by embedding respectful engagement, allyship and inclusive behaviours into daily work.',
    sections: [
      ['Cultural competence, safety and allyship', 'The distinctions between these concepts, and how they intersect to create culturally safe environments.'],
      ['Respectful engagement and communication', 'Practical guidance on listening, silence and two-way communication; avoiding assumptions; using respectful language.'],
      ['Acknowledgement vs Welcome to Country', 'Knowing when and how each should be delivered, with real examples and reflection exercises.'],
      ['Reconciliation in action', 'Symbolic, practical and relational actions explored through real workplace scenarios.'],
      ['Creating inclusive workplaces', 'Embedding cultural safety from recruitment through to the celebration of cultural events.'],
      ['Ongoing learning', 'Encouraging curiosity and continued reflection, with recommended books, podcasts and events.']
    ],
    outcomes: [
      'Build confidence in engaging respectfully across cultures',
      'Deliver meaningful Acknowledgements of Country',
      'Translate reconciliation values into tangible workplace actions',
      'Commit to ongoing learning and allyship beyond the training'
    ],
    interactive: [
      'Scenario-based drag-and-drop activities on competence, safety and allyship',
      'Personal reflection and action commitment statements',
      'Practical self-assessment on cultural confidence'
    ]
  }
];

const features = [
  {
    icon: 'set',
    title: 'SCORM-compliant, ready for your LMS',
    body: 'Interactive modules supplied in SCORM format, so they upload straight into your existing learning management system and report completions the way the rest of your training does.'
  },
  {
    icon: 'users',
    title: 'Narrated by Angela Johnson',
    body: 'Written and narrated throughout by Angela Johnson, a proud Gooreng Gooreng woman and founder of 2Ways Consultancy. The voice teaching this content is the voice it belongs to.'
  },
  {
    icon: 'compass',
    title: 'Accessible on any device',
    body: 'Designed for desktop, tablet and mobile, so staff without a fixed desk can complete it in the same format as everyone else.'
  },
  {
    icon: 'check',
    title: 'Knowledge checks and reflection points',
    body: 'Built-in checks and reflection prompts measure engagement rather than just completion — you can see that people worked through it, not only that they opened it.'
  },
  {
    icon: 'spark',
    title: 'Visually rich design',
    body: 'Aboriginal artwork, interactive maps and motion graphics throughout, rather than narrated slides with stock photography.'
  },
  {
    icon: 'doc',
    title: 'Meets RAP cultural learning commitments',
    body: 'Suitable for cultural learning deliverables at every RAP level. Engaging a Supply Nation registered Indigenous business also contributes to your Indigenous procurement outcomes.'
  }
];

// Licence pricing. All figures exclude GST.
//
// The per-seat rate must descend down this table, and every band must cost
// less than buying that many single licences. The original figures inverted
// both — a 10-user bundle worked out at $318 a seat against a $210 single,
// so ten singles were $1,080 cheaper than the bundle meant to reward volume.
// Fixed by raising the single-seat price rather than discounting the bands,
// which keeps the top tier at the figure Angela set.
const licences = [
  { tier: 'Single user', price: '$290', perSeat: '$290' },
  { tier: 'Up to 10 users', price: '$2,700', perSeat: '$270' },
  { tier: 'Up to 25 users', price: '$6,250', perSeat: '$250' },
  { tier: 'Up to 50 users', price: '$11,750', perSeat: '$235' },
  { tier: 'Up to 100 users', price: '$22,110', perSeat: '$221' }
];

const faqs = [
  {
    q: 'How is the training purchased?',
    a: 'As a package, in one of two ways. Most organisations take a one-year licence for a set number of users, priced by band — from a single user through to 100 users. Alternatively the program can be purchased outright, so your organisation owns it and can keep running it without an ongoing arrangement with us. We do not sell individual ad-hoc sessions. Outright ownership is quoted per organisation; get in touch and we will price it against your numbers.'
  },
  {
    q: 'How long does the training take to complete?',
    a: 'The three modules run to approximately 90 minutes in total. They are designed to be taken in sequence, since each builds on the one before, but learners can complete them across separate sittings rather than in one block.'
  },
  {
    q: 'Can we run it through our own LMS?',
    a: 'Yes. The modules are SCORM-compliant, so they can be uploaded to your existing learning management system and tracked alongside your other training. If you do not have an LMS, tell us and we will talk through the options.'
  },
  {
    q: 'Does this meet our RAP cultural learning commitment?',
    a: 'It is built for exactly that purpose and is suitable at every RAP level. What changes with RAP type is depth and reach: a Reflect RAP might commit to introducing cultural learning, while Stretch and Elevate RAPs are expected to show it is mandatory, ongoing and reaching the whole organisation. The reporting your LMS produces is the evidence for that commitment.'
  },
  {
    q: 'Who wrote and narrated the content?',
    a: 'Angela Johnson, a proud Gooreng Gooreng woman with cultural connections to Country in the Bundaberg and Gladstone regions, and founder of 2Ways Consultancy. The series draws on truth-telling, lived experience and contemporary leadership insight — it is not a course licensed from elsewhere and re-recorded.'
  },
  {
    q: 'What happens when the licence period ends?',
    a: 'Licences run for one year from activation. At the end of the term you can renew for another year, move to a larger user band if your headcount has grown, or discuss purchasing the program outright if the training has become a permanent part of your onboarding.'
  }
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Cultural Competence eLearning Series',
  description:
    'A three-module Aboriginal and Torres Strait Islander cultural competence eLearning series, written and narrated by Angela Johnson of 2Ways Consultancy. Covers Indigenous history and the impacts of colonisation, contemporary realities and systemic inequity, and building cultural competence, allyship and reconciliation in the workplace.',
  provider: { '@id': `${SITE.url}/#organization` },
  inLanguage: 'en-AU',
  educationalCredentialAwarded: 'Certificate of completion',
  timeRequired: 'PT90M',
  teaches: modules.flatMap((m) => m.outcomes),
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT90M'
  },
  syllabusSections: modules.map((m, i) => ({
    '@type': 'Syllabus',
    position: i + 1,
    name: `${m.name} — ${m.subtitle}`,
    description: m.body
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<BaseLayout
  title={`Cultural Competence eLearning Training | ${SITE.name}`}
  description="A three-module Aboriginal and Torres Strait Islander cultural competence eLearning series, written and narrated by Angela Johnson. SCORM-compliant for your LMS, approximately 90 minutes, licensed per user band or owned outright."
  canonical={`${SITE.url}/services/cultural-awareness-training/`}
  schema={[courseSchema, faqSchema]}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero
    kicker="Cultural Competence eLearning Series"
    title="Cultural awareness training your team will actually finish"
    intro="Three modules. About 90 minutes. Written and narrated by Angela Johnson, a proud Gooreng Gooreng woman — built on truth-telling and lived experience, and delivered as interactive eLearning you can run through your own LMS."
    breadcrumbs={[{ label: 'Services', href: 'services/rap/' }, { label: 'Cultural awareness training' }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`${base}contact/`} class="btn">Request access</a>
      <a href="#pricing" class="btn-outline">See licence pricing</a>
    </div>
  </PageHero>

  <!-- OVERVIEW -->
  <section class="section max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-semibold">A learning journey, not a compliance tick</h2>
    <div class="prose mt-4">
      <p>
        The Cultural Competence eLearning Series is a three-module learning journey that builds understanding,
        empathy and practical skill for engaging respectfully with Aboriginal and Torres Strait Islander peoples.
      </p>
      <p>
        Most online cultural training fails for the same reasons: it is generic, bought off a shelf, and taught by
        someone with no connection to the content. This series is written and narrated by Angela Johnson, and blends
        truth-telling, lived experience and contemporary leadership insight. Every module includes interactive
        activities, reflection exercises and knowledge checks designed to move learners from awareness into action.
      </p>
      <p>
        It is built for organisations meeting cultural learning and workplace inclusion deliverables at
        <strong>every RAP level</strong> — and because 2Ways Consultancy is a 100% Indigenous-owned, Supply Nation
        registered business, the spend counts toward your Indigenous procurement outcomes as well.
      </p>
    </div>
  </section>

  <!-- MODULES -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">The series</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">Three modules, taken in sequence</h2>
      <p class="mt-3 text-white/75">
        Each module builds on the one before it — history first, then the present it produced, then what to do about
        it at work on Monday.
      </p>
    </div>

    <div class="mt-10 grid gap-10">
      {modules.map((m) => (
        <article class="grid-card !p-0 overflow-hidden">
          <img
            src={`${base}${m.image}`}
            alt={`${m.name} — ${m.subtitle}`}
            width="1120"
            height="631"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
          <div class="p-6 md:p-8">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <span class="text-3xl font-extrabold tabular-nums text-brand-light/50">{m.number}</span>
              <h3 class="text-xl md:text-2xl font-semibold">{m.name}</h3>
            </div>
            <p class="mt-1 text-white/70">{m.subtitle}</p>
            <p class="mt-4"><span class="pill">{m.theme}</span></p>
            <p class="mt-5 text-white/80 leading-relaxed max-w-3xl">{m.body}</p>

            <div class="mt-7">
              <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-light">What it covers</h4>
              <dl class="mt-3 grid gap-3 md:grid-cols-2">
                {m.sections.map(([term, detail]) => (
                  <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                    <dt class="text-sm font-semibold text-white/90">{term}</dt>
                    <dd class="mt-1 text-sm text-white/70 leading-relaxed">{detail}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="mt-7 grid md:grid-cols-2 gap-7">
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-light">Learning outcomes</h4>
                <ul class="mt-3 grid gap-2">
                  {m.outcomes.map((o) => (
                    <li class="flex items-start gap-2.5 text-sm text-white/75">
                      <span class="mt-0.5 shrink-0 text-brand-light"><Icon name="check" size={16} /></span>
                      <span class="leading-relaxed">{o}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-light">Interactive elements</h4>
                <ul class="mt-3 grid gap-2">
                  {m.interactive.map((el) => (
                    <li class="flex items-start gap-2.5 text-sm text-white/75">
                      <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-light"></span>
                      <span class="leading-relaxed">{el}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="max-w-2xl">
      <p class="kicker">Program features</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-semibold">Built to drop into how you already train</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {features.map((f) => (
        <div class="grid-card">
          <span class="icon-soft"><Icon name={f.icon as any} size={20} /></span>
          <h3 class="mt-4 font-semibold leading-snug">{f.title}</h3>
          <p class="mt-2 text-sm text-white/70 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="light-section scroll-mt-24">
    <div class="section">
      <div class="max-w-2xl">
        <p class="kicker">Investment</p>
        <h2 class="mt-2 text-2xl md:text-3xl font-semibold text-slate-900">Licence pricing</h2>
        <p class="mt-3 text-slate-700">
          The full series — all three modules — under a one-year licence, priced by the number of people who need
          access.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[520px] max-w-2xl border-separate border-spacing-0 rounded-2xl overflow-hidden text-left">
          <thead>
            <tr>
              <th class="p-4 bg-white font-semibold text-slate-900 border-b border-slate-200">Individual and team access</th>
              <th class="p-4 bg-white font-semibold text-slate-900 border-b border-slate-200 text-right">Per person</th>
              <th class="p-4 bg-white font-semibold text-slate-900 border-b border-slate-200 text-right">Investment</th>
            </tr>
          </thead>
          <tbody>
            {licences.map((l, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                <td class="p-4 text-slate-700">{l.tier}</td>
                <td class="p-4 text-right tabular-nums whitespace-nowrap text-slate-500">{l.perSeat}</td>
                <td class="p-4 text-right font-semibold tabular-nums whitespace-nowrap text-slate-900">{l.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-sm text-slate-600 max-w-2xl leading-relaxed">
        All licences run for one year and cover the complete three-module series. The per-person rate drops as the
        band grows, so a 100-user licence works out at roughly a quarter less per head than a single seat. Prices are
        in AUD and exclude GST.
      </p>
      <p class="mt-3 text-sm text-slate-600 max-w-2xl leading-relaxed">
        Need more than 100 users, or want to own the program outright rather than licence it?
        <a href={`${base}contact/`} class="underline" style="color:#8a6a1f;">Get in touch</a> and we will quote against
        your numbers.
      </p>

      <a href={`${base}contact/`} class="btn mt-7 inline-flex">Request access</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section max-w-3xl">
    <p class="kicker">Questions</p>
    <FAQ faqs={faqs} heading="Training FAQs" emitSchema={false} />
  </section>

  <CTASection
    title="Roll it out to your team"
    body="Tell us how many people need access and when you want them through it, and we'll recommend a licence band and get you set up."
    primaryLabel="Request access"
    primaryHref="contact/"
    secondaryLabel="See how we work"
    secondaryHref="how-we-work/"
  />

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
