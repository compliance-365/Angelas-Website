---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

// Repositioned from generic "Business and Strategic Planning", which read as
// management-consulting boilerplate with an Indigenous paragraph appended and
// competed with every consultancy in the country. Reframed around the work
// only an Indigenous-owned consultancy can credibly do: strategy and policy
// through a cultural lens, including for organisations not yet ready for — or
// not pursuing — the formal RAP framework.
const howWeConduct = [
  {
    title: 'Indigenous engagement strategy',
    body: 'A clear strategy for how your organisation engages with Aboriginal and Torres Strait Islander peoples, communities and organisations — useful in its own right, and the groundwork that makes a future RAP achievable.'
  },
  {
    title: 'Embedding reconciliation into corporate strategy',
    body: 'Connecting reconciliation commitments to your actual business strategy, so they are resourced and governed like everything else rather than run as a separate program alongside the organisation.'
  },
  {
    title: 'Policy review through a cultural lens',
    body: 'Reviewing existing policies and procedures for barriers, blind spots and language that undermines stated commitments — often the cheapest and fastest improvement available to an organisation.'
  },
  {
    title: 'Pre-RAP groundwork',
    body: 'For organisations that are not ready to commit to the RAP framework yet, structured work on relationships, internal understanding and governance that makes a later Reflect RAP straightforward rather than daunting.'
  },
  {
    title: 'Board and executive advisory',
    body: 'Direct advice to leadership on reconciliation strategy, risk and accountability — including honest input on whether stated ambitions are supported by what the organisation is actually resourcing.'
  }
];
---
<ServiceLayout
  slug="services/business-strategic"
  navTitle="Indigenous Engagement Strategy"
  pageTitle="Indigenous Engagement Strategy"
  metaDescription="Indigenous engagement strategy, policy review through a cultural lens, and pre-RAP groundwork for Australian organisations — delivered by Indigenous consultants."
  heroBlurb="Strategy and policy work for organisations that want to engage well with Aboriginal and Torres Strait Islander peoples, whether or not they are pursuing a formal RAP."
  whatIsHeading="Strategy work outside the RAP framework"
  whatIsBody="Not every organisation is ready for a Reconciliation Action Plan, and not every organisation needs one. Some need to build relationships and internal understanding first. Some need their policies reviewed for barriers they cannot see. Some have a RAP and need reconciliation genuinely connected to business strategy rather than running beside it. This service covers that work — grounded in the same Indigenous-led judgement, without requiring the formal framework."
  pullquote="A RAP is a framework, not a prerequisite for doing this well. What matters is whether your organisation engages genuinely — and for some organisations, the honest first step is groundwork rather than a public commitment."
  howWeConduct={howWeConduct}
  howWeHelp="We work with organisations at very different starting points: some with no prior engagement at all, others with a mature RAP that has never been properly connected to how the business actually runs. In both cases the value is the same — Indigenous-led judgement on what is genuine, what is achievable, and what is worth doing first. If you are weighing up whether a RAP is the right vehicle for your organisation, that is a good conversation to start with, and one we are happy to have honestly."
  schemaDescription="Indigenous engagement strategy, cultural policy review, pre-RAP groundwork and board-level reconciliation advisory, delivered by Indigenous consultants."
/>
