---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const howWeConduct = [
  { title: 'Tailored strategic roadmaps', body: 'We partner with you to develop comprehensive business and strategic plans that align with your unique vision and goals, ensuring a clear path for growth and sustainability.' },
  { title: 'Organisational health check', body: 'Our expertise includes a thorough review of your current organisational strategies, policies, and procedures, providing insights and recommendations for improvement.' },
  { title: 'Framework development and implementation', body: 'We assist in establishing robust organisational frameworks that enhance operational efficiency, governance, and cultural responsiveness.' },
  { title: 'Policy and procedure optimisation', body: 'From inception to refinement, we help craft and update policies and procedures that are effective, compliant, and culturally appropriate for your organisation.' },
  { title: 'Future-focused advisory', body: 'We provide strategic advice that not only addresses your current challenges but also positions your business for future success and resilience, ensuring a culturally informed and progressive approach.' }
];
---
<ServiceLayout
  slug="services/business-strategic"
  navTitle="Business and Strategic Planning"
  pageTitle="Business and Strategic Planning"
  metaDescription="Discover how our consultancy supports organisations in developing and implementing effective Reconciliation Action Plans through strategic and business planning."
  heroBlurb="Providing expert guidance and strategic support to help organisations achieve their business objectives and sustainable growth."
  whatIsHeading="What are our business and strategic planning services?"
  whatIsBody="At 2Ways Consulting, our business and strategic planning services are designed to empower your organisation with a clear vision and a roadmap for the future. We collaborate with you to develop strategies, refine existing policies, and establish effective frameworks, ensuring your business is resilient in today's landscape and primed for sustainable growth and success."
  pullquote="Our business and strategic planning services equip organisations with the clarity, direction, and tools they need to thrive—today and into the future."
  howWeConduct={howWeConduct}
  howWeHelp="At 2Ways Consulting, we are passionate about helping organisations develop inclusive, culturally safe, and respectful business strategies that value and empower Aboriginal and Torres Strait Islander peoples. Our business and strategic planning services are designed to enable genuine understanding, enable meaningful engagement, and embed sustainable change across all levels of your organisation. If you're ready to elevate your strategic approach and build a more inclusive, resilient, and culturally confident organisation, we'd be delighted to partner with you."
  schemaDescription="Business and strategic planning support including organisational health checks, frameworks and policy development, delivered with cultural responsiveness."
/>
