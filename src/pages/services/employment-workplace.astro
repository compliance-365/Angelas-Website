---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const howWeConduct = [
  { title: 'Employment pathways', body: 'We assist in developing targeted employment strategies designed to attract, recruit, and retain Aboriginal and Torres Strait Islander peoples.' },
  { title: 'Workplace cultural safety and inclusivity', body: 'We guide the review and development of workplace strategies that embed cultural safety, ensuring your environment is welcoming, respectful, and supportive for Aboriginal and Torres Strait Islander employees.' },
  { title: 'Anti-racism framework development', body: 'We support the creation and implementation of anti-racism policies and initiatives, providing practical steps to identify and address racism in your workplace.' },
  { title: 'Policy and procedure alignment', body: 'We help you align your employment policies and procedures to promote fairness and inclusion for Aboriginal and Torres Strait Islander peoples.' },
  { title: 'Building a representative and resilient workforce', body: 'We assist you in developing a representative and resilient workforce that incorporates the diverse perspectives and strengths of Aboriginal and Torres Strait Islander peoples.' }
];
---
<ServiceLayout
  slug="services/employment-workplace"
  navTitle="Employment and Workplace"
  pageTitle="Employment and Workplace"
  metaDescription="Discover how 2Ways Consulting supports organisations in developing inclusive, culturally safe, and respectful workplaces for Aboriginal and Torres Strait Islander peoples."
  heroBlurb="Empowering workplaces to build inclusive, culturally safe environments that attract, support, and retain Aboriginal and Torres Strait Islander peoples."
  whatIsHeading="What is employment and workplace?"
  whatIsBody="At 2Ways Consulting, our Aboriginal and Torres Strait Islander employment and workplace services are dedicated to creating inclusive and culturally safe workplaces. We partner with you to develop and refine strategies that not only attract and retain Aboriginal and Torres Strait Islander talent but also create an environment free from discrimination, where cultural diversity is celebrated and valued."
  pullquote="Our employment and workplace services empower organisations to create inclusive, culturally safe, and respectful environments where Aboriginal and Torres Strait Islander peoples can thrive and contribute their unique strengths."
  howWeConduct={howWeConduct}
  howWeHelp="At 2Ways Consulting, we are committed to supporting organisations in building inclusive, culturally safe, and respectful workplaces where Aboriginal and Torres Strait Islander peoples feel valued and empowered. Our employment and workplace services are designed to help you develop targeted employment strategies, implement cultural safety measures, and enable a workplace that celebrates diversity and drives sustainable change. If you're ready to build a workforce that reflects your commitment to inclusion and respect, we'd be delighted to partner with you."
  schemaDescription="Employment and workplace services covering employment pathways, cultural safety, anti-racism frameworks and policy alignment."
/>
