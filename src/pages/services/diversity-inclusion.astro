---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

// Repositioned from generic "Diversity and Inclusion Programs", which
// duplicated Employment & Workplace almost entirely (both covered cultural
// safety, anti-racism and policy) and used non-Indigenous-specific D&I
// language. Reframed around the outward-facing half: how the organisation
// serves and engages Aboriginal and Torres Strait Islander clients and
// communities, as distinct from how it treats its own workforce.
const howWeConduct = [
  {
    title: 'Culturally safe service delivery review',
    body: 'Assessing whether your services are genuinely accessible and culturally safe for Aboriginal and Torres Strait Islander clients — from first contact and intake through to complaints and escalation.'
  },
  {
    title: 'Community program design',
    body: 'Designing community-facing programs and partnerships with, rather than for, Aboriginal and Torres Strait Islander communities — so they reflect what communities have actually asked for.'
  },
  {
    title: 'Communications and representation review',
    body: 'Reviewing how your organisation represents Aboriginal and Torres Strait Islander peoples in communications, imagery and public materials, including protocols for appropriate use.'
  },
  {
    title: 'Inclusive practice frameworks',
    body: 'Practical frameworks that translate inclusion commitments into how frontline teams actually operate day to day, rather than leaving them as values on a wall.'
  },
  {
    title: 'Measuring inclusion outcomes',
    body: 'Establishing what good looks like for your Aboriginal and Torres Strait Islander clients and communities, and how you would know whether you are achieving it.'
  }
];
---
<ServiceLayout
  slug="services/diversity-inclusion"
  navTitle="Inclusive Practice & Community Programs"
  pageTitle="Inclusive Practice and Community Programs"
  metaDescription="Culturally safe service delivery, community program design and inclusive practice frameworks for Aboriginal and Torres Strait Islander clients and communities."
  heroBlurb="Making sure the way your organisation serves and engages Aboriginal and Torres Strait Islander clients and communities matches what it commits to internally."
  whatIsHeading="Inclusion beyond your own workforce"
  whatIsBody="Most inclusion work focuses inward — recruitment, retention, workplace culture. That matters, and it is what our Employment and Workplace service covers. This service covers the outward-facing half: whether the people your organisation serves actually experience it as culturally safe. An organisation can have strong internal cultural safety and still deliver services that Aboriginal and Torres Strait Islander clients find inaccessible, unwelcoming, or simply not designed with them in mind."
  pullquote="Cultural safety is judged by the people receiving the service, not by the organisation delivering it. That distinction is where most inclusion work either becomes real or stays theoretical."
  howWeConduct={howWeConduct}
  howWeHelp="This work suits organisations with Aboriginal and Torres Strait Islander clients, service users or community stakeholders — government services, health, education, utilities, community and not-for-profit organisations. It complements a RAP by giving the Respect and Relationships pillars something concrete to point at in service delivery, and it complements our Employment and Workplace service by covering the outward-facing side of the same commitment."
  schemaDescription="Culturally safe service delivery review, community program design, communications and representation review, and inclusive practice frameworks for Aboriginal and Torres Strait Islander clients and communities."
/>
