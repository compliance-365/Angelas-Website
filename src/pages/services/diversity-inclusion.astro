---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const howWeConduct = [
  { title: 'Assessment', body: "We start by assessing your organisation's current diversity and inclusion practices, identifying strengths and areas for improvement. This involves reviewing your policies, procedures, and workplace culture." },
  { title: 'Strategic planning', body: 'Based on the assessment, we develop a customised strategy that aligns with your organisational goals. Our plans are actionable and focused on achieving measurable outcomes.' },
  { title: 'Implementation', body: 'We work closely with your team to implement the strategies, providing the necessary tools, training, and resources. Our hands-on approach ensures smooth execution and effective results.' },
  { title: 'Engagement', body: 'We foster engagement within your organisation and the broader community, including facilitating workshops, seminars, and stakeholder consultations to promote understanding and participation.' },
  { title: 'Monitoring and reporting', body: 'We continuously monitor the progress of our programs and evaluate their impact, providing comprehensive reports that document outcomes, successes and areas for further development.' }
];
---
<ServiceLayout
  slug="services/diversity-inclusion"
  navTitle="Diversity and Inclusion Programs"
  pageTitle="Diversity and Inclusion Programs"
  metaDescription="Discover our Diversity and Inclusion Programs and how we help organisations create inclusive workplaces that value diversity and promote equal opportunities."
  heroBlurb="Fostering a more inclusive and equitable workplace through targeted initiatives and strategic support."
  whatIsHeading="What are Diversity and Inclusion Programs?"
  whatIsBody="Our Diversity and Inclusion Programs are designed to help organisations create inclusive workplaces that value diversity and promote equal opportunities. We provide tailored solutions to support your organisation in building a culture of inclusion, respect, and collaboration — from inclusive recruitment strategies and Employee Resource Groups to policy development and leadership mentoring."
  pullquote="Diversity and Inclusion Programs are essential for fostering a workplace environment that respects and values all individuals, driving innovation and growth through diverse perspectives and inclusive practices."
  howWeConduct={howWeConduct}
  howWeHelp="At 2Ways Consulting, we are dedicated to helping organisations build inclusive, diverse, and successful workplaces — from inclusive recruitment and Employee Resource Groups to policy development and mentorship pathways for diverse employees. Let us partner with you to drive meaningful change and achieve your diversity and inclusion goals."
  schemaDescription="Diversity and Inclusion Programs covering assessment, strategic planning, implementation, engagement and reporting for inclusive workplaces."
/>
