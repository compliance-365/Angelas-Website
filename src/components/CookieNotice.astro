---
// Simple accept/decline cookie notice. The live site has a four-category
// preference form (essential/analytics/marketing/performance); this is a
// deliberately simplified two-choice version — flagged in the migration PR
// as a follow-up if full granular consent categories are needed.
---
<div id="cookie-notice" class="fixed inset-x-0 bottom-0 z-[90] hidden p-4">
  <div class="mx-auto max-w-3xl rounded-2xl p-4 md:p-5 flex flex-col md:flex-row items-center gap-4 shadow-lg" style="background:#1B263B;color:#EDEDED;">
    <p class="text-sm flex-1">
      This website uses cookies to enhance your experience.
      <a href={`${import.meta.env.BASE_URL}privacy/`} class="underline" style="color:#FFC451;">Learn more.</a>
    </p>
    <div class="flex gap-3 shrink-0">
      <button id="cookie-essential" class="btn-outline">Essential only</button>
      <button id="cookie-accept" class="btn">Accept all</button>
    </div>
  </div>
</div>

<script is:inline>
  const COOKIE_KEY = '2ways-cookie-consent';
  const notice = document.getElementById('cookie-notice');
  if (notice && !localStorage.getItem(COOKIE_KEY)) {
    notice.classList.remove('hidden');
  }
  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'all');
    notice?.classList.add('hidden');
  });
  document.getElementById('cookie-essential')?.addEventListener('click', () => {
    localStorage.setItem(COOKIE_KEY, 'essential');
    notice?.classList.add('hidden');
  });
</script>
