---
// Accessible FAQ list built on <details>, so it works with zero JS. Emits
// FAQPage schema, which is the single highest-leverage markup for getting
// quoted by AI answer engines and Google's "People also ask".
//
// `emitSchema` can be turned off when a page already emits FAQPage schema
// via BaseLayout — duplicate FAQPage blocks on one URL are invalid.
export interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  emitSchema?: boolean;
}

const { faqs, heading, emitSchema = true } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
{heading && <h2 class="text-2xl md:text-3xl font-semibold">{heading}</h2>}
<div class="mt-6 grid gap-3">
  {faqs.map((f) => (
    <details class="group grid-card !p-0 overflow-hidden">
      <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold list-none">
        <span>{f.q}</span>
        <span aria-hidden="true" class="shrink-0 text-brand-light transition-transform group-open:rotate-45 text-xl leading-none">+</span>
      </summary>
      <div class="px-5 pb-5 -mt-1 text-sm text-white/80 leading-relaxed" set:html={f.a} />
    </details>
  ))}
</div>

{emitSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

<style>
  /* Safari shows a disclosure triangle unless this is explicitly removed. */
  summary::-webkit-details-marker { display: none; }
</style>
