---
const base = import.meta.env.BASE_URL; // "/" locally, "/Angelas-Website/" on Pages

const services = [
  { label: 'Reconciliation Action Plans (RAP)', href: 'services/rap/' },
  { label: 'Business & Strategic Planning', href: 'services/business-strategic/' },
  { label: 'Employment & Workplace', href: 'services/employment-workplace/' },
  { label: 'Monitoring & Evaluation', href: 'services/monitoring-evaluation/' },
  { label: 'Diversity & Inclusion Programs', href: 'services/diversity-inclusion/' }
];
---
<header class="sticky top-0 z-50 bg-brand/95 backdrop-blur border-b border-white/10 font-nav">
  <nav class="mx-auto max-w-7xl px-4 py-3 flex items-center justify-between">
    <a href={`${base}`} class="flex items-center gap-3">
      <img src={`${base}brand/logo.png`} alt="2Ways Consultancy logo" width="40" height="40" class="rounded-lg" />
      <div class="leading-tight text-white">
        <span class="font-semibold text-lg">2Ways</span><br />
        <span class="text-sm text-white/70">Consultancy</span>
      </div>
    </a>

    <button id="nav-toggle" class="md:hidden p-2 border border-white/20 rounded-lg text-white"
      aria-label="Toggle menu" aria-expanded="false" aria-controls="navlinks">☰</button>

    <ul id="navlinks" class="hidden md:flex items-center gap-6 text-base font-medium">
      <li><a href={`${base}`}>Home</a></li>
      <li><a href={`${base}about/`}>About</a></li>
      <li class="relative group">
        <button id="services-toggle" class="flex items-center gap-1" aria-expanded="false" aria-controls="services-menu">
          Services
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2"/></svg>
        </button>
        <ul id="services-menu" class="hidden md:group-hover:block md:absolute left-0 top-full mt-2 min-w-[280px] rounded-xl border border-white/10 bg-surface p-2 shadow-lg">
          {services.map((s) => (
            <li><a href={`${base}${s.href}`} class="block rounded-lg px-3 py-2 text-sm hover:bg-white/10">{s.label}</a></li>
          ))}
        </ul>
      </li>
      <li><a href={`${base}contact/`}>Contact</a></li>
    </ul>
    <a href={`${base}contact/`} class="hidden md:inline-flex btn">Get Started</a>
  </nav>
</header>

<script is:inline>
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('navlinks');
  navToggle?.addEventListener('click', () => {
    const expanded = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!expanded));
    navLinks?.classList.toggle('hidden');
  });

  const servicesToggle = document.getElementById('services-toggle');
  const servicesMenu = document.getElementById('services-menu');
  servicesToggle?.addEventListener('click', () => {
    const expanded = servicesToggle.getAttribute('aria-expanded') === 'true';
    servicesToggle.setAttribute('aria-expanded', String(!expanded));
    servicesMenu?.classList.toggle('hidden');
  });
</script>
