---
// Numbered process timeline. The connecting rail is drawn with a pseudo-
// element on each item rather than a single absolutely-positioned line, so it
// stays correct however many steps are passed in and however tall they get.
export interface Props {
  steps: { title: string; body: string; meta?: string }[];
}

const { steps } = Astro.props;
---
<ol class="mt-8 grid gap-0">
  {steps.map((step, i) => (
    <li class="relative grid grid-cols-[auto_1fr] gap-5 pb-8 last:pb-0">
      <div class="relative flex flex-col items-center">
        <span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-brand-light/40 bg-surface font-semibold text-brand-light tabular-nums">
          {i + 1}
        </span>
        {i < steps.length - 1 && (
          <span aria-hidden="true" class="absolute top-11 bottom-0 w-px bg-gradient-to-b from-brand-light/40 to-white/5"></span>
        )}
      </div>
      <div class="pt-1.5 pb-2">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="font-semibold text-lg">{step.title}</h3>
          {step.meta && <span class="pill">{step.meta}</span>}
        </div>
        <p class="mt-2 text-white/75 leading-relaxed">{step.body}</p>
      </div>
    </li>
  ))}
</ol>
