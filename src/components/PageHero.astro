---
import Breadcrumbs from './Breadcrumbs.astro';

// Shared hero band. Centralises the textured background, spacing and type
// scale so every page's hero matches without copy-pasting the markup.
export interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  breadcrumbs?: { label: string; href?: string }[];
  align?: 'left' | 'center';
  width?: 'narrow' | 'wide';
}

const { kicker, title, intro, breadcrumbs, align = 'left', width = 'wide' } = Astro.props;
const maxW = width === 'narrow' ? 'max-w-3xl' : 'max-w-5xl';
const isCentered = align === 'center';
---
<section class="relative overflow-hidden">
  <div class="absolute inset-0 hero-pattern"></div>
  <div class={`relative mx-auto ${maxW} px-4 py-16 md:py-24 ${isCentered ? 'text-center' : ''}`}>
    {breadcrumbs && (
      <div class={`mb-4 ${isCentered ? 'flex justify-center' : ''}`}>
        <Breadcrumbs items={breadcrumbs} />
      </div>
    )}
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class="mt-3 text-3xl md:text-5xl font-extrabold text-white leading-[1.12]">{title}</h1>
    {intro && (
      <p class={`mt-5 text-lg text-white/75 leading-relaxed max-w-2xl ${isCentered ? 'mx-auto' : ''}`}>{intro}</p>
    )}
    <slot />
  </div>
</section>
