---
// Standard end-of-page conversion block. Every substantial page ends with one
// so there's always a next step without each page reinventing the markup.
export interface Props {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const base = import.meta.env.BASE_URL;
const {
  title = 'Not sure where to start?',
  body = 'Take a free five-minute readiness check, or book a no-obligation conversation about where your organisation is up to.',
  primaryLabel = 'Take the free RAP assessment',
  primaryHref = 'assessment/',
  secondaryLabel = 'Book a discovery call',
  secondaryHref = 'contact/'
} = Astro.props;
---
<section class="section">
  <div class="relative overflow-hidden rounded-2xl border border-brand-light/20 bg-surface p-8 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full"
      style="background: radial-gradient(circle, rgba(255,196,81,.18), transparent 70%);"
    ></div>
    <div class="relative grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="text-2xl md:text-3xl font-semibold">{title}</h2>
        <p class="mt-2 max-w-xl text-white/75">{body}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn" href={`${base}${primaryHref}`}>{primaryLabel}</a>
        <a class="btn-outline" href={`${base}${secondaryHref}`}>{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
